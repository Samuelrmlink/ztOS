# the force press's pressure level (kernel/patch-touch-force.py's force_level): the
# shell, in group video, sets it from Settings > haptics; root's alone otherwise
ACTION=="add|bind", SUBSYSTEM=="i2c", DRIVER=="s6sy761", RUN+="/usr/bin/chgrp video /sys%p/force_level", RUN+="/usr/bin/chmod g+w /sys%p/force_level"
