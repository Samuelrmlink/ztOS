[Unit]
Description=Charging policy: charger limits from the charger type and the battery temperature
# A daemon, woken by the power-supply uevents it watches itself: no udev rule
# starts it, so there is no start limit to hit.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/sbin/zrn-charge --daemon
Restart=on-failure
RestartSec=2
# what each charger did before (zrn-charge --show / --forget)
StateDirectory=zrn-charge

[Install]
WantedBy=multi-user.target
