#!/bin/sh
# meas LABEL SETTLE_S N [STEP_S]: battery current/power, mean of N samples after SETTLE_S,
# with what else happened in the window (CPU busy, screen, interrupt rates)
B=/sys/class/power_supply/max170xx_battery
L=$1; S=${2:-30}; N=${3:-60}; T=${4:-1}
[ "$(cat /sys/class/power_supply/max77705-charger/online)" = 1 ] && { echo "$L CHARGER-ONLINE"; exit 1; }
sleep "$S"
F=/tmp/meas.$$
irq() { awk '/abox|s9p-decon|14360000.i2c|arch_timer|IPI1:|brcmf|s6sy761|ufshcd|bcm_spi|ttyBCM|mcu_ipc/{s=0;for(i=2;i<=NF;i++){if($i!~/^[0-9]+$/)break;s+=$i}; n=$NF; if($1=="IPI1:")n="ipi_fn"; if(n~/decon/)n="decon" $1; if(n~/i2c/)n="i2c1"; print n, s}' /proc/interrupts; }
irq > $F.i0; head -1 /proc/stat > $F.s0
cc0=$(cat $B/charge_counter 2>/dev/null); t0=$(date +%s.%N)
i=0; : > $F
while [ $i -lt $N ]; do echo "$(cat $B/current_now) $(cat $B/voltage_now)" >> $F; i=$((i+1)); sleep "$T"; done
cc1=$(cat $B/charge_counter 2>/dev/null); t1=$(date +%s.%N); avg=$(cat $B/current_avg)
irq > $F.i1; head -1 /proc/stat > $F.s1
scr=$(grep '^screen' /run/user/1000/ztmetro.state 2>/dev/null | cut -d' ' -f2)
busy=$(cat $F.s0 $F.s1 | awk '{t=0;for(i=2;i<=NF;i++)t+=$i; id=$5+$6; if(NR==1){t0=t;i0=id}else printf "%.1f", 100*(1-(id-i0)/(t-t0))}')
rates=$(awk -v d="$N" 'NR==FNR{a[$1]=$2;next}{printf "%s=%.0f ", $1, ($2-a[$1])/d}' $F.i0 $F.i1)
sort -n $F | awk -v L="$L" -v avg="$avg" -v cc0="$cc0" -v cc1="$cc1" -v t0="$t0" -v t1="$t1" -v scr="$scr" -v busy="$busy" -v rates="$rates" '
{ i=-$1/1000; v=$2/1e6; s+=i; ss+=i*i; p+=i*v; n++; a[n]=i }
END { m=s/n; sd=sqrt(ss/n-m*m); med=a[int((n+1)/2)];
 ccma=(cc0-cc1)*3600/(t1-t0)/1000;
 "date +%T" | getline now;
 printf "%s %-22s n=%d mean=%.1fmA med=%.1f se=%.1f P=%.0fmW cc=%.0fmA | screen=%s busy=%s%% %s\n", now, L, n, m, med, sd/sqrt(n), p/n, ccma, scr, busy, rates }'
rm -f $F $F.i0 $F.i1 $F.s0 $F.s1
