#!/bin/sh
# ztlock: one agent at a time on the phone for anything that disturbs it
# (screen on/off, power measurements, installs, service/shell restarts, builds).
#   ztlock run OWNER 'command...'   wait (up to 30 min) for the lock, run, release
#   ztlock who                       who holds it, since when, doing what
# The lock is /run/ztbench/lock (flock); /run/ztbench/owner says who has it (tmpfiles.d makes the dir).
L=/run/ztbench/lock O=/run/ztbench/owner
# inside a queued ztbench test the queue already holds the lock: run straight through
if [ "${ZTB_LOCKED:-}" = 1 ] && [ "$1" = run ]; then shift 2; exec sh -c "$*"; fi
case "$1" in
# The lock file is opened read-only on a descriptor, never by name: flock FILE opens
# it with O_CREAT, which fs.protected_regular refuses even to root for a file another
# user owns in the sticky /run/ztbench.
who) exec 9<"$L" || exit 1
	if flock -n 9; then echo free; else cat "$O" 2>/dev/null || echo held; fi ;;
run) owner=$2; shift 2
	exec 9<"$L" || exit 1
	flock -w 1800 9 || { echo "ztlock: still busy after 30 min: $(cat "$O" 2>/dev/null)" >&2; exit 1; }
	echo "$owner since $(date +%T): $*" > "$O" 2>/dev/null || true
	trap 'rm -f "$O"' EXIT
	# the command runs without fd 9: a daemon it starts (ztnotifyd, 2026-11-12)
	# would otherwise keep the lock open for good after this script exits
	sh -c "$*" 9<&- ;;
*) echo "usage: ztlock run OWNER 'cmd' | ztlock who" >&2; exit 2 ;;
esac
