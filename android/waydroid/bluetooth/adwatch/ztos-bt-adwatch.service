[Unit]
Description=ztOS: advertisements as received, for Android apps' Bluetooth scans
Documentation=file:///usr/share/doc/ztos-waydroid/waydroid.md
Requires=ztos-bt-adwatch.socket

[Service]
ExecStart=/usr/lib/ztos-waydroid/btbridge/ztos-bt-adwatch
# One capability, for a trusted management socket it only reads from: no
# root, no other privilege, no files.
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
ProtectSystem=strict
# /run/user/UID must be visible (the client check); home directories need not be
InaccessiblePaths=/home /root
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
