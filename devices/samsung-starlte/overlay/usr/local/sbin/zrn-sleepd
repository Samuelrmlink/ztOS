#!/usr/bin/env python3
"""zrn-sleepd: put the phone into SoC sleep (SYS_SLEEP, AP only: memory and
the modem stay up) when nobody is using it, and back to work when something
wakes it.

It sleeps once all of these hold:
  - the screen has been off for SCREEN_OFF_S;
  - no app is playing or recording sound (zrnperfd's tickle_audio, which
    counts the streams of shown apps, Bluetooth audio among them: stock keeps
    music going the same way, by not sleeping while it plays);
  - no call is up (ztoscorenetworkingd's call=);
  - no charger (a cable means power, and USB networking for the bench);
  - nothing has asked it not to (/run/zrn-sleepd/inhibit/NAME files; a
    file named timed-NAME holds only until its modification time, so a
    short job, such as a push message handed to an app, needs no cleanup);
  - it is switched on (/var/lib/zrn-sleep/enabled).

Two ways to sleep (sleep_mode in CONFIG, ROADMAP 8.16):
  connected (the default): Wi-Fi stays associated. brcmfmac takes the
    BCM4361 into D3 with its firmware running (kernel/patch-brcmfmac-d3.py);
    a packet for the phone wakes it through WL_HOST_WAKE (EINT 7, gpa0-7)
    and is delivered at once: ssh over Tailscale answers in seconds. The
    always-on display, parked on the panel (the shell disables the output
    with s9p_decon's aod_keep, the panel keeps the frame), is redrawn by an
    RTC wake on every minute.
  deep: as before 8.16: Wi-Fi off its link (unbound) for every sleep, back
    in WIFI_WINDOW_S windows; a lit AOD keeps the phone awake.
If the D3 cycle fails (a refused suspend naming brcmfmac) KEEP_FAIL_LIMIT
times in a row, this boot falls back to unbinding Wi-Fi.

What wakes it: the power key (EINT 20), the modem's mailbox (an incoming
call or SMS: zrn-modem's mcu_ipc wake IRQ), Bluetooth's HOST_WAKE (EINT 19),
Wi-Fi's WL_HOST_WAKE (EINT 7, connected mode),
the charger and the PMIC (EINT 14, 1), the sensor hub's host_req (EINT 15,
while lhd holds it as a wake IRQ: zrn-sleep-init's eint_follow), and an RTC
alarm, its own every MAX_SLEEP_S at the latest, or anything sooner that
asked (alarmtimer). The kernel refuses a sleep while host_req is high (the
hub is talking): 'hub-busy', tried again in a few seconds.

A cycle is what the bench trials proved (power/suspend/mif-trial.sh,
power/suspend-test.py), less what only served the tests: the audio driver
suspends its streams and restarts the DSP on resume, Wi-Fi off its PCIe link (the BCM4361 does not
take D3), UFS at spm_lvl 5, the suspend-aware hotplug, the MIF gate shut.

Unattended phone: a mark is on the disk while it sleeps. Found at start, the
last sleep never came back; sleeping is switched off and the shell told. A
clean stop (a reboot, systemctl stop) removes the mark (ExecStopPost) and
undoes a half-prepared sleep: a reboot during the preparations used to look
like a hang and switched sleeping off (26 Oct, three times).

An inhibit written after the last check before the suspend still stops it:
the inhibit directory is watched as a wakeup event (InhibitWatch). A holder
writes its inhibit before it starts the thing it protects.

  zrn-sleepd            run (systemd)
  zrn-sleepd once [SECONDS] [--ignore-inhibit NAME]...
                        one cycle now, conditions or not (screen must be off)
  zrn-sleepd enable | disable | status
  zrn-sleepd log [N | all]
                        the last N lines of the log (50), NUL bytes dropped
"""
import collections, ctypes, errno, json, os, re, select, signal, socket, struct, subprocess, sys, threading, time
from pathlib import Path

sys.path.insert(0, '/usr/lib/ztos/python')
import ztos_user

D = Path('/usr/local/libexec/ztos-power/mif-trial')
LIB = Path('/usr/local/libexec/ztos-power')


def ko(name):
	"""The running kernel's own build of a module (/usr/lib/modules/<release>/extra,
	scripts/build-bt-modules.sh), or the copy in D from before modules followed
	the release (refused by any other kernel release: vermagic)."""
	k = Path('/usr/lib/modules') / os.uname().release / 'extra' / name
	return k if k.exists() else D / name
STATE = Path('/var/lib/zrn-sleep')
ENABLED = STATE / 'enabled'
MARK = STATE / 'sleeping'
LOG = STATE / 'log'
INHIBIT = Path('/run/zrn-sleepd/inhibit')
STATUS = Path('/run/zrn-sleepd/status')
SLEEP = Path('/sys/module/zrn_sleep_init/parameters')
CPUIDLE = Path('/sys/module/zrn_cpuidle/parameters')
HOTPLUG = Path('/sys/module/zrn_hotplug/parameters/suspend_cluster_off')
UFS = Path('/sys/devices/platform/soc@0/11120000.ufs/spm_lvl')
WIFI = Path('/sys/bus/pci/drivers/brcmfmac')
WIFI_DEV = '0000:01:00.0'
PERF = Path('/run/zrnperfd.status')
PUSH = Path(ztos_user.RUNTIME_DIR) / 'zrn-pushd.status'
MODEM = Path('/run/ztoscorenetworking/status')
# The modem's channels: each of its io devices takes its own wakeup source on
# every frame it receives (modem_v1 iodev_lock_wlock), so their counts say
# which channel a CP mailbox wake carried (0xeb umts_ipc0, IPC; 0xf5
# umts_rfs0, file requests; umts_router, AT: RING, +CMTI). The kernel's
# LNK-RX log never shows the AT channel (log_enabled() has no case for it).
WAKEUP = Path('/sys/class/wakeup')
MODEM_SOURCES = ('umts_', 'rmnet', 'multipdp')

SCREEN_OFF_S = 15	# off this long before the first sleep
MAX_SLEEP_S = 1800	# an RTC alarm at the latest after this
# Doze: an app picked to run in the background no longer keeps the phone up.
# It sleeps at most DOZE_SLEEP_S, then stays up DOZE_AWAKE_S with Wi-Fi back,
# so the app (WhatsApp through microG) can fetch what came in. Calls and SMS
# still wake it at once through the modem.
# zrn-pushd counts too: its connection is down while Wi-Fi sleeps, so Google
# holds the messages until a doze window lets it log in again. A window lasts
# until zrn-pushd is back (and PUSH_GRACE_S more, for what Google had held to
# arrive), DOZE_AWAKE_S at the least and DOZE_AWAKE_MAX_S at the most.
DOZE_SLEEP_S = 300
DOZE_AWAKE_S = 10
DOZE_AWAKE_MAX_S = 45
PUSH_GRACE_S = 8
# 'alarm': the RTC woke it before its own alarm, so someone else's alarmtimer
# (Android's *_WAKEUP alarms, zrn-pushd): the app's wake locks do not reach
# the host (no CONFIG_PM_WAKELOCKS; the container's /sys/power is read-only),
# so this is how long it gets to do its job
AWAKE_AFTER = {'rtc': 3, 'modem': 15, 'bt': 5, 'key': 0, 'hub': 5, 'alarm': 20, 'other': 8,
	       'wifi': 6}
# connected mode (see the top): what keeps Wi-Fi associated and the AOD fresh
SLEEP_MODE = 'connected'
WIFI_PHY = 'phy0'
BRCMF = Path('/sys/module/brcmfmac/parameters')
KEEP_FAIL_LIMIT = 2	# refused D3 cycles in a row before unbinding again
# the AOD's minute: no sleep this close before the minute turns (the RTC
# alarm has a 1 s grain and the preparations take seconds), and after a wake
# up to AOD_REDRAW_S for the shell to put the new minute on the panel
AOD_LEAD_S = 4
AOD_REDRAW_S = 8
# awake while the network is in use (an ssh session over Tailscale): this
# many packets in or out over NET_WINDOW_S holds the phone up. 0: off.
NET_BUSY_PKTS = 40
NET_WINDOW_S = 10
EARLY_RTC_S = 3		# an RTC wake this much before its own alarm is 'alarm'
# EINT_WAKEUP_MASK (PMU 0x60c, bit = 8 x gpaN + pin, 0 = may wake): open
# 1 PMIC (gpa0-1), 14 MAX77705 charger (gpa1-6), 19 BT HOST_WAKE (gpa2-3),
# 20 power key (gpa2-4). Bit 15 (the sensor hub's host_req, gpa1-7) stays
# masked here: zrn-sleep-init opens it itself while its IRQ is a wake IRQ
# (eint_follow), as stock's EINT wake mask follows enable_irq_wake.
EINT_WAKE = 0xffe7bffd
# A sleep the firmware gave up (ACPM 'upend_wk': PMU_INTR_GEN GRP4 latched,
# 29 Oct, a whole boot): smc 0, no wake source, back at once. Not a wake.
# Its cause decides what follows (fw_abort_cause):
#   'hub': the sensor hub was busy (host_req latched, GNSS or a hub reset
#     held, the hub not ready): harmless, the hub's own business. Tried again
#     in FW_ABORT_HUB_S, FW_ABORT_HUB_LONG_S once it has happened
#     FW_ABORT_HUB_MANY times in a row; it never pauses sleeping.
#   'other': FW_ABORT_LIMIT in a row and sleeping pauses for PAUSE_S
#     (PAUSED, until= in boot time), rather than churning Wi-Fi, the DSP and
#     the sensor hub every few seconds; then it tries again by itself.
# GRP4 is never forced clear from here: clear_grp4 is written 0 at every
# cycle and nothing writes 1. A sleep forced through a live latch while GNSS
# ran took the hub down (J0c); the firmware's own abort did no harm (J0b).
FW_ABORT_LIMIT = 3
FW_ABORT_RETRY_S = 5
FW_ABORT_SLEPT_S = 2
FW_ABORT_HUB_S, FW_ABORT_HUB_LONG_S, FW_ABORT_HUB_MANY = 20, 300, 6
PAUSE_S = 1800
HUB_HOST_REQ = 1 << 7	# gpa1-7 in eint_before/eint_pending word 1
SENSORHUB_READY = Path('/sys/class/sec/sensorhub/ready')
# the Waydroid container's cgroup: frozen while the screen is off
# (suspend_action=freeze)
CONTAINER_CGROUP = Path('/sys/fs/cgroup/lxc.payload.waydroid')
# the sensor hub keeps waking the phone or refusing its sleeps: this many
# in HUB_WINDOW_S and it is left awake HUB_BACKOFF_S
HUB_BUSY_RETRY_S = 5
HUB_LIMIT, HUB_WINDOW_S, HUB_BACKOFF_S = 3, 120, 120
PAUSED = Path('/run/zrn-sleepd/paused')
CANCEL_RETRY_S = 5	# something woke up during the preparations
ALARM_RETRY_S = 3	# an alarm due within 2 s refused the suspend (EBUSY)
DOZE_NO_NET_S = 15	# a doze window where zrn-pushd gets nowhere ends here
# Low battery: shorter sleeps, so ztoscsf (which polls only while awake)
# sees 2 % and shuts down cleanly before the cell cuts out.
BATTERY = Path('/sys/class/power_supply/max170xx_battery')
LOW_BATTERY = ((4, 120), (10, 600))	# (at or below %, longest sleep s)
SUMMARY_S = 3600	# a line of totals this often, and at stop
# The battery over time: a row in SOC_CSV at every sleep entry, every wake,
# every Wi-Fi return after a wake, and every TICK_S while it stays awake (the
# AOD, a charger, an inhibit), so a night's drain can be plotted whatever
# happened. One O_APPEND write a row and no fsync: the sync before each sleep
# (the mark) puts the rows before it on the disk.
SOC_CSV = STATE / 'soc.csv'
SOC_FIELDS = ('time', 'epoch', 'boot_s', 'event', 'soc', 'charge_now_mah', 'charge_counter_mah',
	      'voltage_mv', 'current_now_ma', 'current_avg_ma', 'temp_c', 'asleep_s', 'awake_s',
	      'reason', 'wifi', 'display', 'charger', 'note')
SOC_ROTATE_BYTES = 8 << 20
TICK_S = 600
# Wi-Fi after a periodic wake: brcmfmac is bound again at once, but
# associating, DHCP and NetworkManager take seconds. When Wi-Fi was up at the
# sleep, a wake by an RTC alarm (ours or someone's) stays up until wlp1s0 is
# up again and WIFI_GRACE_S more (mail, a push, ssh), WIFI_WINDOW_S at most.
# 0 switches the window off (Wi-Fi then comes back only at longer wakes).
WIFI_WINDOW_S = 30
WIFI_GRACE_S = 10
# Wi-Fi need not come back at every wake: with WIFI_INTERVAL_S set, a wake by
# our own RTC alarm before it is due leaves brcmfmac unbound ('parked') and
# sleeps again at once (an AOD minute, a battery row). Any other wake, any
# reason to stay up, and `once` bind it again. 0: at every wake, as before.
WIFI_INTERVAL_S = 0
WIFI_IFACE = 'wlp1s0'
# key=value overrides, read at start and before each sleep (no restart):
#   wake_interval_s=600  wifi_interval_s=0  wifi_window_s=30  wifi_grace_s=10  tick_s=600
CONFIG = STATE / 'config'
CONFIG_KEYS = {'wake_interval_s': 'MAX_SLEEP_S', 'wifi_interval_s': 'WIFI_INTERVAL_S',
	       'wifi_window_s': 'WIFI_WINDOW_S',
	       'wifi_grace_s': 'WIFI_GRACE_S', 'tick_s': 'TICK_S', 'doze_sleep_s': 'DOZE_SLEEP_S',
	       'net_busy_pkts': 'NET_BUSY_PKTS', 'sleep_mode': 'SLEEP_MODE'}
CONFIG_WORDS = {'sleep_mode': ('connected', 'deep')}	# the keys that take a word
SHELL_STATE = Path(ztos_user.RUNTIME_DIR) / 'ztmetro.state'
INHIBIT_OLD_S = 3600	# an inhibit held this long gets a line in the log
LOG_ROTATE_BYTES = 1 << 20	# the log moves to log.1 past this
# /sys/power/wakeup_count blocks while a wakeup source is active: past this
# the cycle gives up (Stalled), and says which source held it
WAKEUP_COUNT_S = 15
# inotify and epoll, for the inhibit watch
IN_ATTRIB, IN_CLOSE_WRITE, IN_MOVED_TO, IN_CREATE = 0x4, 0x8, 0x80, 0x100
IN_Q_OVERFLOW, IN_IGNORED = 0x4000, 0x8000
EPOLLWAKEUP = 1 << 29


class BackgroundApps:
	"""Cache the user's sleep veto; directory watches also catch atomic saves."""
	def __init__(self, home=None):
		self.home = Path(home if home is not None else ztos_user.HOME)
		self.directory = self.home / '.config/ztos'
		self.libc = ctypes.CDLL(None, use_errno=True)
		self.libc.inotify_init1.argtypes = [ctypes.c_int]
		self.libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
		self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
		if self.fd < 0:
			raise OSError(ctypes.get_errno(), 'background apps inotify')
		self.active = True
		self.refresh()

	def close(self):
		if self.fd >= 0:
			os.close(self.fd)
			self.fd = -1

	def refresh(self):
		# Watch ancestors before reading so creating .config/ztos cannot be lost.
		# IN_ONLYDIR, create/delete/move, close-write, attrib, and self removal.
		mask = 0x01000fcc
		watched = False
		for directory in (self.home, self.home / '.config', self.directory):
			if self.libc.inotify_add_watch(self.fd, os.fsencode(directory), mask) >= 0:
				watched = True
		if not watched:
			self.active = True
			return
		try:
			lines = (self.directory / 'background-apps').read_text().splitlines()
		except FileNotFoundError:
			lines = []
		except (OSError, UnicodeError):
			self.active = True
			return
		self.active = any(line.split('#', 1)[0].strip() for line in lines)
		try:
			legacy = (self.directory / 'android.conf').read_text().splitlines()
		except FileNotFoundError:
			legacy = []
		except (OSError, UnicodeError):
			self.active = True
			return
		for line in legacy:
			key, separator, value = line.split('#', 1)[0].partition('=')
			if separator and key.strip() == 'keep_awake':
				self.active |= any(part.strip() for part in value.split(','))

	def held(self, fresh=False):
		changed = fresh
		while True:
			try:
				if not os.read(self.fd, 65536):
					break
				changed = True
			except BlockingIOError:
				break
			except OSError:
				return True
		if changed:
			self.refresh()
		return self.active


_background_apps = None


def push_active():
	"""zrn-pushd holds the device's push connection (it knows the identity)."""
	return kv(PUSH).get('identity') == 'known'


def push_online_since():
	"""When zrn-pushd last logged in (wall clock), or 0 while it is not."""
	status = kv(PUSH)
	if status.get('state') != 'online':
		return 0
	try:
		return int(status.get('since', '0') or 0)
	except ValueError:
		return 0


def background_apps_active(fresh=False):
	global _background_apps
	try:
		if _background_apps is None:
			_background_apps = BackgroundApps()
		return _background_apps.held(fresh)
	except (OSError, KeyError):
		# A broken watch or unavailable user configuration must not kill notifications.
		return True


def log(*words):
	"""A line to the journal and to LOG. One write(2) and fdatasync a line:
	a hard reset once left the file longer than its data (64 NUL bytes,
	30 Oct), and grep then hid every line."""
	line = time.strftime('%Y-%m-%d %H:%M:%S ') + ' '.join(str(w) for w in words)
	print(line, flush=True)
	try:
		try:
			if LOG.stat().st_size > LOG_ROTATE_BYTES:
				os.replace(LOG, LOG.with_name(LOG.name + '.1'))
		except FileNotFoundError:
			pass
		fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
		try:
			os.write(fd, (line + '\n').encode())
			os.fdatasync(fd)
		finally:
			os.close(fd)
	except OSError:
		pass


def repair_log():
	"""NUL bytes in LOG (an unclean stop): keep the file as it was in
	log.nul (once), and put a marker line where each run was."""
	try:
		data = LOG.read_bytes()
	except OSError:
		return
	if b'\0' not in data:
		return
	try:
		keep = os.open(LOG.with_name(LOG.name + '.nul'), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
	except FileExistsError:
		keep = None
	except OSError:
		return
	if keep is not None:
		try:
			os.write(keep, data)
			os.fsync(keep)
		finally:
			os.close(keep)
	out, i = bytearray(), 0
	for run in re.finditer(rb'\0+', data):
		out += data[i:run.start()]
		if out and not out.endswith(b'\n'):
			out += b'\n'
		out += f'-- {run.end() - run.start()} bytes lost: an unclean stop --\n'.encode()
		i = run.end()
		if data[i:i + 1] == b'\n':
			i += 1
	out += data[i:]
	tmp = LOG.with_name('.log.tmp')
	try:
		fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
		try:
			os.write(fd, bytes(out))
			os.fsync(fd)
		finally:
			os.close(fd)
		os.replace(tmp, LOG)
		directory = os.open(LOG.parent, os.O_RDONLY | os.O_DIRECTORY)
		try:
			os.fsync(directory)
		finally:
			os.close(directory)
	except OSError:
		pass


def show_log(lines=50):
	"""The last `lines` of log.1 and LOG (None: all), NUL bytes dropped."""
	text = []
	for path in (LOG.with_name(LOG.name + '.1'), LOG):
		try:
			text += path.read_bytes().replace(b'\0', b'').decode(errors='replace').splitlines()
		except OSError:
			pass
	for line in text if lines is None else text[-lines:] if lines > 0 else []:
		print(line)


_config_seen = None


def load_config():
	"""CONFIG's key=value lines over the defaults; a change is logged."""
	global _config_seen
	text = read(CONFIG)
	values = {}
	for line in text.splitlines():
		key, sep, value = line.split('#', 1)[0].partition('=')
		key = key.strip()
		if sep and key in CONFIG_KEYS:
			if key in CONFIG_WORDS:
				if value.strip() in CONFIG_WORDS[key]:
					values[key] = value.strip()
				continue
			try:
				values[key] = int(value.strip())
			except ValueError:
				pass
	if text != _config_seen:
		for key, name in CONFIG_KEYS.items():
			default = _defaults.setdefault(name, globals()[name])
			globals()[name] = values.get(key, default)
		if _config_seen is not None or values:
			log('config:', ' '.join(f'{k}={globals()[n]}' for k, n in CONFIG_KEYS.items()))
		_config_seen = text


_defaults = {}


def wifi_state():
	"""'unbound' (asleep or off the bus), 'up' (associated and carrying),
	'down', or 'absent'."""
	if not (WIFI / WIFI_DEV).exists():
		return 'unbound'
	state = read(f'/sys/class/net/{WIFI_IFACE}/operstate', '')
	return state if state in ('up', 'down') else (state or 'absent')


def shell_state():
	"""The shell's state file as {key: value}."""
	out = {}
	for line in read(SHELL_STATE).splitlines():
		key, _, value = line.partition(' ')
		out[key] = value.strip()
	return out


def aod_parked():
	"""The AOD is on the panel with the output off (aod_keep): the SoC may
	sleep under it, and the minute is redrawn by a wake."""
	st = shell_state()
	return st.get('screen') == 'off' and st.get('aod') == 'on' and \
		st.get('aod_parked') == 'yes'


def display_state():
	"""'on', 'aod' (the output lit, the shell's AOD showing), 'aod-kept' (the
	AOD parked on the panel, the output off), or 'off'."""
	if screen_off():
		return 'aod-kept' if aod_parked() else 'off'
	st = shell_state()
	if st.get('screen') == 'off' and st.get('aod') == 'on':
		return 'aod'
	return 'on'


def to_minute():
	"""Seconds until the wall clock's next minute."""
	return 60 - time.time() % 60


def aod_due():
	"""Why the parked AOD keeps the phone up now, or None: the minute is
	about to turn, or it turned and the shell has not drawn it yet."""
	if SLEEP_MODE != 'connected' or not aod_parked():
		return None
	if to_minute() < AOD_LEAD_S:
		return 'aod minute'
	try:
		shown = int(shell_state().get('aod_minute', '0'))
	except ValueError:
		shown = 0
	now = time.time()
	if shown < int(now // 60) and now % 60 < AOD_REDRAW_S:
		return 'aod redraw'
	return None


_keep_fails = 0		# refused D3 cycles in a row
_keep_broken = False	# KEEP_FAIL_LIMIT reached: unbind for the rest of the boot


def wifi_keep_ok():
	"""Connected mode can keep Wi-Fi through this sleep: the kernel has the
	D3 path and the host-wake line (patch-brcmfmac-d3.py)."""
	if SLEEP_MODE != 'connected' or _keep_broken:
		return False
	if not (BRCMF / 'd3_acks').exists() or read(BRCMF / 'keep_assoc') != 'Y':
		return False
	return 'brcmf_host_wake' in read('/proc/interrupts')


def wowlan_any():
	"""WoWLAN 'any' on the phy, so cfg80211 keeps the association at suspend
	(brcmfmac's keep_assoc). True when it is on."""
	def on():
		r = run('iw', WIFI_PHY, 'wowlan', 'show', timeout=5)
		return bool(r and r.returncode == 0 and 'is enabled' in r.stdout), r
	ok, r = on()
	if ok:
		return True
	run('iw', WIFI_PHY, 'wowlan', 'enable', 'any', timeout=5)
	ok, r = on()
	log('wowlan any:', 'on' if ok else 'could not be set: ' + (r.stdout.strip() if r else ''))
	return ok


_net = collections.deque()	# (monotonic, packets in and out of WIFI_IFACE)


def net_sample():
	total = 0
	for name in ('rx_packets', 'tx_packets'):
		try:
			total += int(read(f'/sys/class/net/{WIFI_IFACE}/statistics/{name}', '0') or 0)
		except ValueError:
			pass
	now = time.monotonic()
	_net.append((now, total))
	while len(_net) > 2 and now - _net[1][0] >= NET_WINDOW_S:
		_net.popleft()


def net_busy():
	"""Connected mode: packets moving on Wi-Fi (a session in use)."""
	if SLEEP_MODE != 'connected' or not NET_BUSY_PKTS or len(_net) < 2:
		return False
	(t0, p0), (t1, p1) = _net[0], _net[-1]
	return t1 - t0 >= 2 and p1 - p0 >= NET_BUSY_PKTS * min(1.0, (t1 - t0) / NET_WINDOW_S)


def _milli(path, scale=1000):
	try:
		return f'{int(read(path, "")) / scale:.1f}'
	except ValueError:
		return ''


def soc_row(event, asleep=None, awake=None, reason='', note=''):
	"""One row of SOC_CSV: what the battery says now."""
	try:
		temp = f'{int(read(BATTERY / "temp", "")) / 10:.1f}'
	except ValueError:
		temp = ''
	row = (time.strftime('%Y-%m-%d %H:%M:%S'), f'{time.time():.0f}', f'{boottime():.1f}', event,
	       read(BATTERY / 'capacity'), _milli(BATTERY / 'charge_now'),
	       _milli(BATTERY / 'charge_counter'), _milli(BATTERY / 'voltage_now'),
	       _milli(BATTERY / 'current_now'), _milli(BATTERY / 'current_avg'), temp,
	       '' if asleep is None else f'{asleep:.1f}', '' if awake is None else f'{awake:.1f}',
	       reason, wifi_state(), display_state(), 'yes' if plugged() else 'no',
	       note.replace(',', ';'))
	try:
		try:
			if SOC_CSV.stat().st_size > SOC_ROTATE_BYTES:
				os.replace(SOC_CSV, SOC_CSV.with_name(SOC_CSV.name + '.1'))
		except FileNotFoundError:
			pass
		fd = os.open(SOC_CSV, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
		try:
			head = ','.join(SOC_FIELDS) + '\n' if os.fstat(fd).st_size == 0 else ''
			os.write(fd, (head + ','.join(row) + '\n').encode())
		finally:
			os.close(fd)
	except OSError:
		pass


STEP = Path('/run/zrn-sleepd/step')
PREPARE_S = 90		# the preparations take seconds; this long means one is stuck


def step(name):
	"""Where the cycle is: /run/zrn-sleepd/step, so a stall can be pinned to
	one write (a cycle once stalled 22 min between Wi-Fi unbind and suspend,
	2026-10-26, and left no trace)."""
	try:
		STEP.parent.mkdir(parents=True, exist_ok=True)
		STEP.write_text(f'{time.strftime("%H:%M:%S")} {name}\n')
	except OSError:
		pass


class Stalled(Exception):
	"""A preparation step hung; the argument says how long it was given."""
	def __init__(self, seconds=PREPARE_S):
		super().__init__(seconds)
		self.seconds = seconds


def _stalled(signum, frame):
	raise Stalled()


def write(path, value):
	# one write(2), unbuffered: a buffered file that failed (EBUSY from
	# /sys/power/state) writes again when it is closed, and that one sleeps
	fd = os.open(str(path), os.O_WRONLY)
	try:
		os.write(fd, str(value).encode())
	finally:
		os.close(fd)


def read(path, default=''):
	try:
		return Path(path).read_text().strip()
	except OSError:
		return default


def run(*cmd, timeout=20, check=False):
	try:
		return subprocess.run(cmd, timeout=timeout, check=check,
				      stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
	except (subprocess.SubprocessError, OSError) as e:
		log('ran', ' '.join(map(str, cmd)), 'failed:', e)
		if check:
			raise
		return None


def tell_shell(line):
	for uid in range(1000, 1010):
		try:
			fd = os.open(f'/run/user/{uid}/ztmetro.ctl', os.O_WRONLY | os.O_NONBLOCK)
		except OSError:
			continue
		try:
			os.write(fd, (line + '\n').encode())
		except OSError:
			pass
		os.close(fd)


def kv(path):
	out = {}
	for l in read(path).splitlines():
		k, _, v = l.partition('=')
		out[k] = v
	return out


# ---- once a boot ----------------------------------------------------------

def module_options(name='zrn_sleep_init', directory=Path('/etc/modprobe.d')):
	"""`options zrn_sleep_init ...` from modprobe.d: insmod does not read it,
	so a parameter (pdn=0, wdt_resume_s=60) is set there without a rebuild."""
	words = []
	try:
		files = sorted(directory.glob('*.conf'))
	except OSError:
		return words
	for f in files:
		for line in read(f).splitlines():
			fields = line.split('#', 1)[0].split()
			if len(fields) > 2 and fields[0] == 'options' and \
					fields[1].replace('-', '_') == name:
				words += fields[2:]
	return words


def unforce_grp4():
	"""clear_grp4 back to N: an earlier zrn-sleepd set it on the first
	firmware abort and it stayed Y for the boot, forcing every later sleep
	through a live latch."""
	try:
		write(SLEEP / 'clear_grp4', 0)
	except OSError:
		pass


def setup():
	"""The backend and what it leans on, as mif-trial.sh brings them up."""
	if SLEEP.exists():
		if read(SLEEP / 'enable_deep') == 'Y' and 'deep' in read('/sys/power/mem_sleep'):
			unforce_grp4()
			return True
		log('zrn_sleep_init present but deep sleep not enabled, reloading')
		run('rmmod', 'zrn_sleep_init', check=False)
		if SLEEP.exists():
			log('could not unload zrn_sleep_init: not sleeping')
			return False
	if not HOTPLUG.exists():
		run('modprobe', 'zrn-hotplug')
	if not HOTPLUG.exists():
		log('no suspend-aware zrn-hotplug: not sleeping')
		return False
	if not Path('/sys/module/zrn_exynos_rtc').exists():
		run('insmod', ko('zrn-exynos-rtc.ko'), check=False)
	run('python3', D / 'initialize-calendar.py')
	# ACPM's TMU plugin and the buck ramp rates as stock leaves them: in
	# every good trial. ACPM has been seen not to answer once; not fatal.
	run('python3', D / 'load-acpm-tmu.py', D / 'exynos9810_acpm_tmu.fw', LIB / 's9p-acpm')
	run('python3', LIB / 's9p-acpm', 'write', '1', '63', '0')
	run('python3', LIB / 's9p-acpm', 'write', '1', '64', '0')
	syms = {}
	for l in read('/proc/kallsyms').splitlines():
		f = l.split()
		if len(f) >= 3 and f[2] in ('cpu_suspend', 'cpu_resume'):
			syms[f[2]] = f[0]
	if len(syms) != 2:
		log('no cpu_suspend/cpu_resume in kallsyms')
		return False
	r = run('insmod', ko('zrn-sleep-init.ko'), 'enable_deep=1', 'psci_system=0', 'dry_run=1',
		'prepare_only=0', f'eint_wake={EINT_WAKE:#x}',
		f'suspend_enter=0x{syms["cpu_suspend"]}', f'resume=0x{syms["cpu_resume"]}',
		*module_options())
	if r is None or r.returncode or not SLEEP.exists():
		log('backend did not load:', r.stdout.strip() if r else '')
		return False
	write('/sys/power/mem_sleep', 's2idle')
	unforce_grp4()
	log('backend up')
	return True


# ---- the conditions ---------------------------------------------------------

def screen_off():
	states = [read(p) for p in Path('/sys/class/drm').glob('card*-*/enabled')]
	return bool(states) and all(s == 'disabled' for s in states)


def plugged():
	for p in Path('/sys/class/power_supply').iterdir():
		if read(p / 'type') in ('USB', 'Mains') and read(p / 'online') == '1':
			return True
	return False


_held_since = {}	# inhibit name: when it was first seen (monotonic)


def inhibits():
	"""The inhibit files that hold; expired timed- ones are removed."""
	held = []
	if not INHIBIT.exists():
		return held
	now = time.time()
	for p in sorted(INHIBIT.iterdir()):
		if p.name.startswith('timed-'):
			try:
				if p.stat().st_mtime <= now:
					p.unlink(missing_ok=True)
					continue
			except OSError:
				continue
		held.append(p.name)
	mono = time.monotonic()
	for name in list(_held_since):
		if name not in held:
			del _held_since[name]
	for name in held:
		since = _held_since.setdefault(name, mono)
		if since is not None and mono - since >= INHIBIT_OLD_S:
			log(f'inhibit {name} held over {INHIBIT_OLD_S // 60} min')
			_held_since[name] = None	# once
	return held


class InhibitWatch:
	"""An inhibit made late, after the re-check, as a wakeup event.

	A file is not a wakeup event, and this kernel has no CONFIG_PM_WAKELOCKS,
	so an inhibit written in the second between why_awake() and the freezer
	did not stop the suspend. Here inotify on INHIBIT sits in an epoll with
	EPOLLWAKEUP: the writer's own rename/utime/close wakes the epoll, whose
	callback activates a wakeup source in that same syscall. From then until
	drain() the wakeup_count write fails (EINVAL) or the suspend aborts
	(EBUSY): pm_save_wakeup_count and pm_wakeup_pending see it in flight.
	The kernel strips EPOLLWAKEUP without CAP_BLOCK_SUSPEND; armed() reads
	what it kept from /proc/self/fdinfo. Deletions are not watched: the
	daemon's own removal of an expired inhibit is not an event.

	The contract for a holder: write the inhibit before starting the thing
	it protects."""
	MASK = IN_CREATE | IN_MOVED_TO | IN_ATTRIB | IN_CLOSE_WRITE

	def __init__(self, path=None):
		self.path = Path(path if path is not None else INHIBIT)
		self.ep = None
		self.ignored = False
		libc = ctypes.CDLL(None, use_errno=True)
		libc.inotify_init1.argtypes = [ctypes.c_int]
		libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
		self.fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
		if self.fd < 0:
			raise OSError(ctypes.get_errno(), 'inhibit watch: inotify_init1')
		try:
			if libc.inotify_add_watch(self.fd, os.fsencode(self.path), self.MASK) < 0:
				err = ctypes.get_errno()
				raise OSError(err, f'inhibit watch on {self.path}: {os.strerror(err)}')
			self.ino = os.stat(self.path).st_ino
			self.ep = select.epoll()
			self.ep.register(self.fd, select.EPOLLIN | select.EPOLLET | EPOLLWAKEUP)
		except BaseException:
			self.close()
			raise

	def close(self):
		if self.ep is not None:
			self.ep.close()
			self.ep = None
		if self.fd >= 0:
			os.close(self.fd)
			self.fd = -1

	def armed(self, fdinfo=None):
		"""EPOLLWAKEUP kept on the item: 'tfd: FD events: HEX ...'."""
		text = fdinfo if fdinfo is not None else read(f'/proc/self/fdinfo/{self.ep.fileno()}')
		for line in text.splitlines():
			f = line.split()
			if len(f) >= 4 and f[0] == 'tfd:' and f[2] == 'events:' and f[1] == str(self.fd):
				try:
					return bool(int(f[3], 16) & EPOLLWAKEUP)
				except ValueError:
					return False
		return False

	def drain(self):
		"""Read every event and let the wakeup source go. True if any came
		other than the watch's own end (IN_IGNORED)."""
		seen = False
		while self.fd >= 0:
			try:
				buf = os.read(self.fd, 65536)
			except BlockingIOError:
				break
			except OSError:
				break
			if not buf:
				break
			off = 0
			while off + 16 <= len(buf):
				_wd, mask, _cookie, length = struct.unpack_from('iIII', buf, off)
				if mask & IN_IGNORED:
					self.ignored = True
				else:
					seen = True
				off += 16 + length
		if self.ep is not None:
			try:
				self.ep.poll(0)	# ep_send_events relaxes the item's source
			except OSError:
				pass
		return seen

	def stale(self):
		"""The directory went (rmdir, a new /run): watch the new one."""
		if self.ignored:
			return True
		try:
			return os.stat(self.path).st_ino != self.ino
		except OSError:
			return True


_watch = None
_watch_failed = False


def ensure_watch():
	"""The inhibit watch, built or rebuilt as needed; None if it cannot be
	(then the re-check before the wakeup_count write is all there is)."""
	global _watch, _watch_failed
	if _watch is not None and not _watch.stale():
		return _watch
	if _watch is not None:
		_watch.close()
		_watch = None
	try:
		INHIBIT.mkdir(parents=True, exist_ok=True)
		watch = InhibitWatch(INHIBIT)
		armed = watch.armed()
		# it sees what a writer does: a file made and removed
		probe = INHIBIT / '.watch-selftest'
		probe.touch()
		probe.unlink(missing_ok=True)
		works = watch.drain()
		if not armed:
			log('inhibit watch not armed (EPOLLWAKEUP stripped): late inhibits are not caught')
		elif not works:
			log('inhibit watch self-test failed: late inhibits may not be caught')
		else:
			log('inhibit watch armed')
		_watch, _watch_failed = watch, False
	except OSError as e:
		if not _watch_failed:
			log('inhibit watch:', e)
		_watch_failed = True
		_watch = None
	return _watch


def paused():
	"""PAUSED holds while boot time is before its until=; then it goes."""
	try:
		text = PAUSED.read_text()
	except OSError:
		return False
	until = None
	for word in text.split():
		key, _, value = word.partition('=')
		if key == 'until':
			try:
				until = float(value)
			except ValueError:
				pass
	if until is not None and boottime() < until:
		return True
	PAUSED.unlink(missing_ok=True)
	log('sleep pause over: trying again')
	return False


def why_awake(ignore=(), ignore_inhibits=()):
	"""None when it may sleep; else what keeps it up. `ignore`: reasons
	that do not count (`once` ignores the charger and the switch);
	`ignore_inhibits`: inhibit names that do not count (a bench)."""
	def audio():
		try:
			return int(kv(PERF).get('tickle_audio', '0') or 0) > 0
		except ValueError:
			return False
	for name, holds in (
			('switched off', lambda: not ENABLED.exists()),
			('paused', paused),
			('screen on', lambda: not screen_off()),
			('charger', plugged),
			('call', lambda: kv(MODEM).get('call', 'idle') not in ('', 'idle')),
			('audio', audio)):
		if name not in ignore and holds():
			if name == 'screen on' and display_state() == 'aod':
				return 'aod showing'
			return name
	if 'screen on' not in ignore:
		if SLEEP_MODE == 'deep' and aod_parked():
			return 'aod showing'
		due = aod_due()
		if due:
			return due
	if 'network' not in ignore and net_busy():
		return 'network'
	held = [name for name in inhibits() if name not in ignore_inhibits]
	if held:
		return 'inhibit ' + ','.join(held)
	return None


def active_sources():
	"""Names of the wakeup sources active now."""
	out = []
	for p in WAKEUP.glob('*'):
		try:
			if int(read(p / 'active_time_ms', '0') or 0) > 0:
				out.append(read(p / 'name'))
		except ValueError:
			pass
	return out


def cgroup_frozen(path):
	for line in read(Path('/sys/fs/cgroup') / path.lstrip('/') / 'cgroup.events').splitlines():
		key, _, value = line.partition(' ')
		if key == 'frozen':
			return value.strip() == '1'
	return False


def epollwakeup_timerfd_cgroups(proc=Path('/proc')):
	"""The cgroups of the processes that poll a timerfd with EPOLLWAKEUP."""
	groups = set()
	for pdir in proc.iterdir():
		if not pdir.name.isdigit():
			continue
		try:
			infos = list((pdir / 'fdinfo').iterdir())
		except OSError:
			continue
		for info in infos:
			text = read(info)
			for m in re.finditer(r'tfd:\s+(\d+)\s+events:\s+([0-9a-f]+)', text):
				if not int(m.group(2), 16) & EPOLLWAKEUP:
					continue
				try:
					target = os.readlink(pdir / 'fd' / m.group(1))
				except OSError:
					continue
				if 'timerfd' in target:
					groups.add(read(pdir / 'cgroup').split('::')[-1] or '/')
	return groups


def frozen_timerfd_holders():
	"""Every active wakeup source is a '[timerfd]' and every timerfd polled
	with EPOLLWAKEUP belongs to a frozen cgroup: Android's AlarmManager
	(system_server) in the Waydroid container, frozen with the screen off.
	Its expired timers hold their sources active until it reads them, which
	it cannot do frozen, so /sys/power/wakeup_count would block all night."""
	active = active_sources()
	if not active or any(name != '[timerfd]' for name in active):
		return False
	groups = epollwakeup_timerfd_cgroups()
	return bool(groups) and all(cgroup_frozen(g) for g in groups)


_pending_reader = None	# a wakeup_count read still blocked from an earlier cycle


def read_wakeup_count(seconds=WAKEUP_COUNT_S):
	"""/sys/power/wakeup_count, read without hanging on our own watch.

	The read blocks while any wakeup source is active. An inhibit written
	just before it activates the watch's own source, which only drain()
	lets go: so the read runs in a thread, and this thread drains while it
	waits. Past `seconds` some other source holds it: Stalled."""
	global _pending_reader
	box = {}

	def reader():
		box['count'] = read('/sys/power/wakeup_count')
	if _watch is not None:
		_watch.drain()
	if _pending_reader is not None and _pending_reader.is_alive():
		# still blocked since an earlier stall: no second thread
		raise Stalled(0)
	thread = threading.Thread(target=reader, name='wakeup_count', daemon=True)
	_pending_reader = thread
	thread.start()
	end = time.monotonic() + seconds
	while True:
		thread.join(1)
		if not thread.is_alive():
			return box.get('count', '')
		if _watch is not None:
			_watch.drain()
		if time.monotonic() >= end:
			raise Stalled(seconds)


# ---- one sleep ----------------------------------------------------------------

def bt_sleep_mode():
	"""The BCM4361's UART sleep (vendor 0xfc27), with HOST_WAKE active low and
	pulsed: lost on every controller reset, so sent before each sleep."""
	if not Path('/sys/class/bluetooth/hci0').exists():
		return
	try:
		s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI)
		s.bind((0,))
		s.setsockopt(socket.SOL_HCI, socket.HCI_FILTER,
			     struct.pack('<IIIHxx', 0xffffffff, 0xffffffff, 0xffffffff, 0))
		params = bytes([1, 2, 2, 1, 0, 1, 1, 0, 0, 0, 0, 1])
		s.send(bytes([0x01]) + struct.pack('<HB', 0xfc27, len(params)) + params)
		s.settimeout(2)
		deadline = time.monotonic() + 2
		while time.monotonic() < deadline:
			ev = s.recv(260)
			if ev[0] == 0x04 and ev[1] == 0x0e and struct.unpack_from('<H', ev, 4)[0] == 0xfc27:
				if ev[6]:
					log('bt sleep mode refused', ev[6])
				break
		s.close()
	except OSError as e:
		log('bt sleep mode:', e)


def number(path):
	try:
		return int(read(path, '0') or 0, 0)
	except ValueError:
		return 0


def rtc_early(t_alarm, alarm_s, t_woke):
	"""Back (boot time) before our own RTC alarm, written at t_alarm for
	+alarm_s, was due: another alarmtimer set the RTC sooner. Measured from
	the wakealarm write, not from the suspend: the preparations after it
	(settle, sync, the gadget) take seconds."""
	if t_alarm is None or t_woke is None:
		return False
	return t_woke < t_alarm + alarm_s - EARLY_RTC_S


def words(name):
	"""A comma list module parameter (eint_before, eint_pending)."""
	try:
		return [int(x or 0) for x in read(SLEEP / name, '').split(',')]
	except ValueError:
		return []


def fw_abort_cause():
	"""Why the firmware gave a sleep up: 'hub' when the sensor hub was busy
	(host_req latched, raw, before zrn-sleep-init discarded masked bits;
	GNSS or a hub reset holding; the hub not ready), else 'other'. A masked
	line alone (gpa1-0, the noise eint_before also keeps) is 'other'."""
	for name in ('eint_before', 'eint_pending'):
		w = words(name)
		if len(w) > 1 and w[1] & HUB_HOST_REQ:
			return 'hub'
	for name in ('timed-gnss', 'timed-hub'):
		if (INHIBIT / name).exists():
			return 'hub'
	if read(SENSORHUB_READY, '1') != '1':
		return 'hub'
	return 'other'


def fw_abort_detail():
	grp4 = number(SLEEP / 'grp4_before')
	return (f'grp4_before={grp4:#010x} grp4_at_smc={read(SLEEP / "grp4_at_smc", "n/a")} '
		f'eint_before={read(SLEEP / "eint_before")} eint_pending={read(SLEEP / "eint_pending")}')


def container_frozen():
	"""Android's container frozen (True), running (False), or unknown."""
	for line in read(CONTAINER_CGROUP / 'cgroup.events').splitlines():
		key, _, value = line.partition(' ')
		if key == 'frozen':
			return value.strip() == '1'
	return None


def wake_reason(before, slept=None, early_rtc=False):
	stat = number(SLEEP / 'wake_stat')
	# EINT pending, one word a bank: gpa0, gpa1, gpa2, gpa3, gpa4
	eint = [int(x or 0) for x in read(SLEEP / 'eint_pending', '0').split(',')]
	gpa2 = eint[2] if len(eint) > 2 else 0
	if number(SLEEP / 'entries') <= before:
		return 'aborted', stat
	# the firmware gave the sleep up: GRP4 latched at the handoff, or back
	# at once with no wake source at all (bit 31 is only a status flag).
	# GRP4 as it was at the SMC: zrn-sleep-init clears a stale latch after
	# grp4_before is read (an older module has only grp4_before)
	grp4 = SLEEP / 'grp4_at_smc'
	if number(grp4 if grp4.exists() else SLEEP / 'grp4_before') or (
			number(SLEEP / 'last_smc') == 0 and not stat & 0x7fffffff and
			not number(SLEEP / 'wake_stat2') and not number(SLEEP / 'wake_stat3') and
			not any(eint) and slept is not None and slept < FW_ABORT_SLEPT_S):
		return 'fw-abort', stat
	if gpa2 & (1 << 4):
		return 'key', stat
	if gpa2 & (1 << 3):
		return 'bt', stat
	if eint and eint[0] & (1 << 7):
		return 'wifi', stat
	# an EINT wake with the sensor hub's host_req (gpa1-7) pending
	if stat & 1 and len(eint) > 1 and eint[1] & 0x80:
		return 'hub', stat
	if stat & (1 << 24):
		return 'modem', stat
	if stat & (1 << 1):
		# our own alarm, or someone else's sooner one (Android's)
		return ('alarm' if early_rtc else 'rtc'), stat
	return 'other', stat


class Cancelled(Exception):
	pass


def battery_cap():
	"""The longest sleep the battery's charge allows, or None."""
	try:
		capacity = int(read(BATTERY / 'capacity', ''))
	except ValueError:
		return None
	for percent, longest in LOW_BATTERY:
		if capacity <= percent:
			return longest
	return None


def charge_uah():
	try:
		return int(read(BATTERY / 'charge_now', ''))
	except ValueError:
		return None


def wakeup_sources():
	"""Wakeup sources active now or changed in the last 10 s, for the log."""
	now_ms = time.clock_gettime(time.CLOCK_MONOTONIC) * 1000
	out = []
	for p in Path('/sys/class/wakeup').glob('wakeup*'):
		try:
			active = int(read(p / 'active_time_ms', '0') or 0)
			change = int(read(p / 'last_change_ms', '0') or 0)
		except ValueError:
			continue
		if active or now_ms - change < 10000:
			out.append(f'{read(p / "name")}(active_count={read(p / "active_count")} '
				   f'last_change={change})')
	return ' '.join(out) or 'none'


def modem_counts():
	"""{name: (wakeup_count, event_count)} of the modem's channels."""
	out = {}
	for p in WAKEUP.glob('*'):
		name = read(p / 'name')
		if not name.startswith(MODEM_SOURCES):
			continue
		try:
			out[name] = (int(read(p / 'wakeup_count', '0') or 0), int(read(p / 'event_count', '0') or 0))
		except ValueError:
			continue
	return out


def modem_rx(before, after):
	"""The channels that received between two modem_counts(): 'umts_rfs0 +10'.
	A source missing from either side is left out."""
	moved = []
	for name in sorted(after):
		if name not in before:
			continue
		wakeups = after[name][0] - before[name][0]
		events = after[name][1] - before[name][1]
		if wakeups > 0 or events > 0:
			moved.append(f'{name} +{max(wakeups, events)}')
	return ', '.join(moved)


def woke_text(reason, info):
	"""The reason as the log gives it: a modem wake names its channels."""
	rx = info.get('modem_rx')
	if reason == 'modem':
		return f'modem ({rx or "no channel rx"})'
	return f'{reason} (modem rx: {rx})' if rx else reason


def failed_device():
	return read('/sys/power/suspend_stats/last_failed_dev')


# what the last cycle measured, for main(): time asleep, charge in and out
last_sleep = {}


def cycle(ignore=(), ignore_inhibits=()):
	"""One sleep and the way back. Returns why it woke. `ignore_inhibits`:
	inhibit names the re-check does not count (a bench)."""
	dozing = background_apps_active(fresh=True) or push_active()
	alarm_s = min(MAX_SLEEP_S, DOZE_SLEEP_S) if dozing else MAX_SLEEP_S
	cap = battery_cap()
	if cap is not None and cap < alarm_s:
		log(f'battery low: sleeping at most {cap}s')
		alarm_s = cap
	# the parked AOD's next minute: back just after it turns
	aod_alarm = False
	if SLEEP_MODE == 'connected' and aod_parked():
		minute = max(1, int(to_minute()) + 1)
		if minute < alarm_s:
			alarm_s, aod_alarm = minute, True
	last_sleep.clear()
	t_start = boottime()
	t_in = None
	user_env = ['env', 'XDG_RUNTIME_DIR=' + ztos_user.RUNTIME_DIR]
	user = ztos_user.USER
	entries = int(read(SLEEP / 'entries', '0') or 0)
	hub_refused = number(SLEEP / 'hub_refused')	# 0 with an older module
	global wifi_parked, last_wake_boot
	# parked by the last wake: still ours to bind again
	wifi_bound = (WIFI / WIFI_DEV).exists() or wifi_parked
	wifi_before = 'parked' if wifi_parked else wifi_state()
	# connected mode: brcmfmac stays bound and takes the dongle into D3
	wifi_kept = bool(not wifi_parked and (WIFI / WIFI_DEV).exists() and wifi_keep_ok() and
			 wowlan_any())
	last_sleep['wifi_kept'] = wifi_kept
	if not wifi_parked:
		last_wifi['before'] = wifi_before
	last_sleep['wifi_before'] = wifi_before
	old_ufs = read(UFS)
	reason, stat = 'failed', 0
	audio_out = False
	settle = 1
	slept = None
	t_alarm = t_woke = None	# boot time: the RTC alarm written, the return
	# on a cable (bench, `once`) the USB gadget is let go for the sleep, as
	# the trials did; the daemon itself never sleeps on a charger
	udc = next(Path('/sys/kernel/config/usb_gadget').glob('*/UDC'), None)
	controller = read(udc) if udc and plugged() else ''
	try:
		bt_sleep_mode()
		# The driver suspends ALSA and restores its DSP without removing the
		# card. Keep Pulse clients connected, including Android's audioserver.
		if read('/sys/module/snd_zrn_abox/parameters/pm_ready') != 'Y':
			log('audio driver has no suspend support: refusing sleep')
			return 'audio unavailable', 0
		audio_out = True
		old_alarm = signal.signal(signal.SIGALRM, _stalled)
		signal.alarm(PREPARE_S)
		try:
			if wifi_bound and (WIFI / WIFI_DEV).exists() and not wifi_kept:
				settle = 3
				step('wifi down')
				run('ip', 'link', 'set', 'wlp1s0', 'down')
				step('wifi unbind')
				write(WIFI / 'unbind', WIFI_DEV)
			step('ufs spm_lvl')
			write(UFS, 5)
			step('hotplug')
			write(HOTPLUG, 1)
			step('mif_sleep')
			write(SLEEP / 'mif_sleep', 0)
			step('mem_sleep deep')
			write('/sys/power/mem_sleep', 'deep')
			step('rtc alarm')
			write('/sys/class/rtc/rtc0/wakealarm', 0)
			write('/sys/class/rtc/rtc0/wakealarm', f'+{alarm_s}')
			t_alarm = time.clock_gettime(time.CLOCK_BOOTTIME)
			# never forced: nothing here writes 1 (a clear while the hub
			# talked took it down, J0c); 0 undoes a hand-set Y
			step('clear_grp4 0')
			try:
				write(SLEEP / 'clear_grp4', 0)
			except OSError as e:
				log('clear_grp4 0:', e)
			step('dry_run 0')
			write(SLEEP / 'dry_run', 0)
			if controller:
				settle = 3
				step('usb gadget off')
				for _ in range(10):
					try:
						write(udc, '\n')
						break
					except OSError:
						time.sleep(2)
			# a wakeup event since the count was read: the write fails, and so
			# does the sleep; the event is served instead. Read after the
			# preparations: unbinding Wi-Fi and the gadget count as events,
			# and they set the Bluetooth chip talking (HOST_WAKE pulses):
			# give it its idle threshold (600 ms) and some to go quiet.
			# With only the sleep-mode command sent to it, a second will do.
			step('settle')
			time.sleep(settle)
			step('mark and sync')
			MARK.write_text(str(time.time()))
			os.sync()
			step('wakeup_count')
			ensure_watch()
			# Android's frozen timers would block the read: sleep without
			# the count (late inhibits then rest on the re-check alone)
			if frozen_timerfd_holders():
				count = None
				log('wakeup_count skipped: only frozen Android timers hold wakeup sources')
			else:
				try:
					count = read_wakeup_count()
				except Stalled:
					if not frozen_timerfd_holders():
						raise
					count = None
					log('wakeup_count skipped after a stall: frozen Android timers hold it')
			# what happened during the preparations (a power key press, a
			# call, a new inhibit) stops the sleep here; anything later
			# moves the count, and the write below fails. An inhibit
			# written after this check is a wakeup event too (InhibitWatch):
			# the write fails (EINVAL) or the suspend does (EBUSY)
			why = why_awake(ignore, ignore_inhibits)
			if why:
				raise Cancelled(why)
			try:
				if count is not None:
					write('/sys/power/wakeup_count', count)
			except OSError as e:
				if e.errno == errno.EINVAL:
					raise Cancelled('a wakeup event during the check: ' + wakeup_sources())
				raise
			# the modem's channels as the window opens: what moves until a
			# second after the return is what woke the phone (the frames that
			# wake it are read by the resume path within milliseconds)
			rx_before = modem_counts()
			# only now is the sleep going ahead (an append is no wakeup
			# event); it reaches the disk with the next sync or writeback
			soc_row('sleep', awake=(boottime() - last_wake_boot) if last_wake_boot else None,
				note=f'alarm +{alarm_s}s; wifi was {wifi_before}' + ('; dozing' if dozing else ''))
			signal.alarm(0)		# the sleep itself may last MAX_SLEEP_S
			step('suspend')
			last_sleep['charge_in'] = charge_uah()
			t_in = time.clock_gettime(time.CLOCK_BOOTTIME)
			try:
				write('/sys/power/state', 'mem')
			finally:
				t_woke = time.clock_gettime(time.CLOCK_BOOTTIME)
				slept = t_woke - t_in
				last_sleep['slept'] = slept
				last_sleep['charge_out'] = charge_uah()
			time.sleep(1.0)
			last_sleep['modem_rx'] = modem_rx(rx_before, modem_counts())
		except Cancelled as e:
			log(f'sleep cancelled: {e}')
			reason = 'cancelled'
		except OSError as e:
			if e.errno == errno.EBUSY and number(SLEEP / 'hub_refused') > hub_refused:
				log('sleep refused: the sensor hub is talking (host_req high)')
				reason = 'hub-busy'
			elif e.errno == errno.EBUSY and _watch is not None and _watch.drain():
				log('sleep cancelled after the re-check: an inhibit changed '
				    f'({",".join(inhibits()) or "none held now"})')
				reason = 'cancelled'
			else:
				log('sleep refused:', e.strerror)
				if e.errno == errno.EBUSY and 'alarmtimer' in failed_device():
					reason = 'alarm-due'
				else:
					log('wakeup sources:', wakeup_sources())
					if wifi_kept and WIFI_DEV in failed_device():
						keep_failed(failed_device())
		except Stalled as e:
			log(f'sleep abandoned: stuck at "{read(STEP)}" for {e.seconds}s')
			log('wakeup sources:', wakeup_sources())
			reason = 'stalled'
		finally:
			signal.alarm(0)
			signal.signal(signal.SIGALRM, old_alarm)
			step('restoring')
		if reason not in ('stalled', 'cancelled', 'alarm-due', 'hub-busy'):
			early = rtc_early(t_alarm, alarm_s, t_woke)
			reason, stat = wake_reason(entries, slept, early)
		last_sleep['entered'] = number(SLEEP / 'entries') > entries
		if wifi_kept and last_sleep['entered']:
			global _keep_fails
			_keep_fails = 0
	finally:
		restored = True
		def restore_write(path, value):
			nonlocal restored
			try:
				write(path, value)
			except OSError as e:
				restored = False
				log('restore failed:', path, e)

		if controller:
			restore_write(udc, controller)
		restore_write(SLEEP / 'dry_run', 1)
		restore_write('/sys/power/mem_sleep', 's2idle')
		restore_write('/sys/class/rtc/rtc0/wakealarm', 0)
		if old_ufs:
			restore_write(UFS, old_ufs)
		# a wake by our own alarm before Wi-Fi is due: leave it parked
		wifi_parked = bool(wifi_bound and not wifi_kept and WIFI_INTERVAL_S and reason == 'rtc' and
				   last_wifi.get('next', 0) > boottime() and not audio_failed())
		if wifi_bound and not wifi_parked and not (WIFI / WIFI_DEV).exists():
			restore_write(WIFI / 'bind', WIFI_DEV)
			last_wifi['bound_at'] = boottime()
			last_wifi['next'] = boottime() + WIFI_INTERVAL_S
		if audio_out and read('/sys/module/snd_zrn_abox/parameters/pm_ready') != 'Y':
			restored = False
			log('audio restore failed')
		if restored:
			MARK.unlink(missing_ok=True)
		else:
			ENABLED.unlink(missing_ok=True)
			reason = 'failed'
			tell_shell('notify Power|Sleep switched off|Device recovery failed after sleep.')
	global last_dozing
	last_dozing = dozing
	if last_sleep.get('entered'):
		last_wake_boot = boottime()
		purpose = reason
		if reason == 'rtc':
			purpose = 'aod' if aod_alarm else 'tick' if (wifi_parked or wifi_kept) else 'wifi'
		last_sleep['purpose'] = purpose
		if aod_parked():
			tell_shell('aod tick')	# its own timer stood still while asleep
		# the cycle's own cost: before the suspend, and from the return to here
		cost = ''
		if t_in is not None and t_woke is not None:
			cost = f'prep {t_in - t_start:.1f}s; restore {last_wake_boot - t_woke:.1f}s'
		rx = last_sleep.get('modem_rx', '')
		soc_row('wake', asleep=slept, reason=purpose, note=cost + (f'; modem {rx}' if rx else ''))
	elif reason not in ('cancelled',):
		soc_row('nosleep', reason=reason)
	return reason, stat


last_dozing = False
last_wake_boot = None	# boot time of the last return from the SoC
wifi_parked = False	# brcmfmac left unbound after a wake (WIFI_INTERVAL_S)
last_wifi = {}		# before: its state at the last unparked sleep; bound_at, next: boot time


def keep_failed(device):
	"""A suspend refused by brcmfmac's D3 (no D3_ACK): after KEEP_FAIL_LIMIT
	in a row, Wi-Fi is unbound for every sleep again, this boot."""
	global _keep_fails, _keep_broken
	_keep_fails += 1
	log(f'wifi D3 refused the sleep ({device}), {_keep_fails} in a row')
	if _keep_fails >= KEEP_FAIL_LIMIT:
		_keep_broken = True
		log('wifi D3 keeps failing: unbinding Wi-Fi for sleep until the next boot')


def audio_failed():
	return read('/sys/module/snd_zrn_abox/parameters/pm_ready') != 'Y'


def unpark_wifi(why):
	"""Bind Wi-Fi again if a wake left it parked."""
	global wifi_parked, last_wake_boot
	if not wifi_parked:
		return
	wifi_parked = False
	if not (WIFI / WIFI_DEV).exists():
		try:
			write(WIFI / 'bind', WIFI_DEV)
		except OSError as e:
			log('wifi bind failed:', e)
		last_wifi['bound_at'] = boottime()
		last_wifi['next'] = boottime() + WIFI_INTERVAL_S
	log(f'wifi back: {why}')


# ---- the loop --------------------------------------------------------------------

def status(**fields):
	STATUS.parent.mkdir(parents=True, exist_ok=True)
	STATUS.write_text(''.join(f'{k}={v}\n' for k, v in fields.items()))


def boottime():
	# monotonic time stops while asleep: boot time does not
	return time.clock_gettime(time.CLOCK_BOOTTIME)


def push_progress():
	"""zrn-pushd is getting somewhere: it has a network to try."""
	return kv(PUSH).get('state', '') not in ('', 'offline', 'resolving')


def mah(uah):
	return 'n/a' if uah is None else f'{uah / 1000:.1f}'


class Totals:
	"""This boot's sleeping, summed: a line every SUMMARY_S and at stop."""
	def __init__(self):
		self.t0, self.c0 = boottime(), charge_uah()
		self.cycles = self.fw_aborts = 0
		self.causes = {}	# fw-aborts by cause: hub, other
		self.reasons = {}
		self.asleep_s, self.asleep_uah = 0.0, 0

	def add(self, reason, info):
		self.cycles += 1
		self.reasons[reason] = self.reasons.get(reason, 0) + 1
		self.fw_aborts += reason == 'fw-abort'
		if info.get('entered') and info.get('slept') is not None:
			self.asleep_s += info['slept']
			if info.get('charge_in') is not None and info.get('charge_out') is not None:
				self.asleep_uah += info['charge_in'] - info['charge_out']

	def add_cause(self, cause):
		self.causes[cause] = self.causes.get(cause, 0) + 1

	def line(self):
		total = max(1e-3, boottime() - self.t0)
		now = charge_uah()
		used = self.c0 - now if now is not None and self.c0 is not None else None
		awake_uah = used - self.asleep_uah if used is not None else None
		reasons = ','.join(f'{k}:{v}' for k, v in sorted(self.reasons.items())) or 'none'
		causes = ''.join(f' {k}:{v}' for k, v in sorted(self.causes.items()))
		causes = f' ({causes.strip()})' if causes else ''
		return (f'summary: {total / 3600:.2f} h, cycles={self.cycles} fw-aborts={self.fw_aborts}{causes} '
			f'wakes={reasons} awake={100 * (total - self.asleep_s) / total:.0f}% '
			f'mAh asleep={mah(self.asleep_uah)} awake={mah(awake_uah)} '
			f'soc={read(BATTERY / "capacity", "?")}%')


def bits(word):
	return ','.join(str(i) for i in range(32) if word >> i & 1) or 'none'


def log_alarm_wake(prefix=''):
	"""An 'alarm' wake: was Android's container frozen when it fired?"""
	frozen = container_frozen()
	state = {True: 'frozen', False: 'running', None: 'state unknown'}[frozen]
	log(f'{prefix}alarm wake, container {state}')


def main():
	# systemctl stop, a reboot: SystemExit unwinds a cycle through its
	# restores (Wi-Fi bound again, dry_run back on) before the unit's
	# ExecStopPost removes the mark
	signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(0))
	STATE.mkdir(parents=True, exist_ok=True)
	repair_log()
	INHIBIT.mkdir(parents=True, exist_ok=True)
	ensure_watch()
	if MARK.exists():
		MARK.unlink()
		ENABLED.unlink(missing_ok=True)
		log('the last sleep never came back: sleeping switched off')
		tell_shell('notify Power|Sleep switched off|The phone did not wake from its last sleep.')
	ready = False
	off_since = None
	backoff = 0
	sleeps = 0
	fails = 0		# failed cycles in a row: the backoff doubles
	fw_aborts = 0		# sleeps the firmware gave up, cause 'other', in a row
	hub_aborts = 0		# and cause 'hub', in a row
	pause_told = False	# the shell hears of a pause once a boot
	wakes, woke_at = 0, 0	# real returns from the SoC (the sensor hub's side reads them)
	window = None		# a doze window: (woke, wall clock woke, its end at the latest)
	hub_times = collections.deque()	# when the hub woke the phone or refused a sleep
	unforce_grp4()
	last = {}
	totals = Totals()
	summary_at = time.monotonic() + SUMMARY_S
	load_config()
	soc_row('start', note=f'wake_interval {MAX_SLEEP_S}s; wifi_interval {WIFI_INTERVAL_S}s; '
		f'enabled {ENABLED.exists()}')
	tick_at = time.monotonic() + TICK_S
	wifi_wait = None	# after a wake: (woke, boot time, deadline) until Wi-Fi is back
	try:
		while True:
			# an inhibit change while awake is no reason to stay awake:
			# let the watch's wakeup source go every pass
			watch = ensure_watch()
			if watch is not None:
				watch.drain()
			net_sample()
			quick = False
			why = why_awake()
			if why is not None and why != 'switched off':
				unpark_wifi(why)
			if wifi_wait:
				woke_b, deadline = wifi_wait
				state = wifi_state()
				if state == 'up':
					took = boottime() - woke_b
					soc_row('wifi', reason='up', note=f'reassociated {took:.1f}s after the wake')
					log(f'wifi up {took:.1f}s after the wake')
					wifi_wait = None
					backoff = max(backoff, time.monotonic() + WIFI_GRACE_S)
				elif boottime() >= deadline:
					soc_row('wifi', reason='timeout', note=f'not up {WIFI_WINDOW_S}s after the wake ({state})')
					log(f'wifi not back {WIFI_WINDOW_S}s after the wake ({state})')
					wifi_wait = None
				elif why is None:
					why = 'wifi window'
			if time.monotonic() >= tick_at:
				soc_row('awake', reason=why or 'waiting')
				tick_at = time.monotonic() + TICK_S
			if screen_off():
				off_since = off_since or time.monotonic()
			else:
				off_since = None
			if why is None and window:
				woke, woke_wall, latest = window
				online = push_online_since()
				mono = time.monotonic()
				if mono >= latest:
					window = None
				# logged in again, or its connection lived through the
				# sleep (LTE): what Google held has had PUSH_GRACE_S
				elif online and time.time() >= max(online, woke_wall) + PUSH_GRACE_S:
					window = None
				# no network to log in through: no reason to wait 45 s
				elif mono - woke >= DOZE_NO_NET_S and not push_progress():
					window = None
				elif not push_active():
					window = None
				else:
					why = 'doze window'
			if why is None and off_since and time.monotonic() - off_since >= SCREEN_OFF_S and \
					time.monotonic() >= backoff:
				if not ready:
					ready = setup()
					if not ready:
						ENABLED.unlink(missing_ok=True)
						tell_shell('notify Power|Sleep switched off|Its driver did not load.')
						continue
				load_config()
				t0 = boottime()
				reason, stat = cycle()
				tick_at = time.monotonic() + TICK_S
				sleeps += 1
				slept = round(boottime() - t0)
				info = dict(last_sleep)
				totals.add(reason, info)
				if info.get('entered'):
					wakes += 1
					woke_at = int(time.time())
				charge = ''
				if info.get('slept') is not None:
					charge = (f' (asleep {info["slept"]:.1f}s, charge {mah(info.get("charge_in"))}'
						  f'->{mah(info.get("charge_out"))} mAh)')
				log(f'woke: {woke_text(reason, info)} wake_stat={stat:#010x} after {slept}s{charge}')
				if reason == 'alarm':
					log_alarm_wake()
				mono = time.monotonic()
				if reason == 'fw-abort':
					cause = fw_abort_cause()
					totals.add_cause(cause)
					if cause == 'hub':
						hub_aborts += 1
						n = hub_aborts
					else:
						fw_aborts += 1
						n = fw_aborts
					log(f'the firmware gave the sleep up (cause {cause}, {n} in a row): '
					    f'{fw_abort_detail()}')
					if cause == 'hub':
						# the hub's business, and harmless: never a pause
						backoff = mono + (FW_ABORT_HUB_LONG_S if hub_aborts >= FW_ABORT_HUB_MANY
								  else FW_ABORT_HUB_S)
					elif fw_aborts >= FW_ABORT_LIMIT:
						until = boottime() + PAUSE_S
						PAUSED.parent.mkdir(parents=True, exist_ok=True)
						PAUSED.write_text(f'until={until:.0f} {fw_abort_detail()}\n')
						log(f'sleep paused for {PAUSE_S // 60} min: the firmware refuses it')
						if not pause_told:
							tell_shell('notify Power|Sleep paused|The firmware refuses to sleep; '
								   f'it tries again in {PAUSE_S // 60} min.')
							pause_told = True
						fw_aborts = 0
					else:
						backoff = mono + FW_ABORT_RETRY_S
				elif reason == 'cancelled':
					backoff = mono + CANCEL_RETRY_S
				elif reason == 'hub-busy':
					backoff = mono + HUB_BUSY_RETRY_S
				elif reason == 'alarm-due':
					backoff = mono + ALARM_RETRY_S
				elif reason in ('failed', 'aborted', 'stalled', 'audio unavailable'):
					fails += 1
					backoff = mono + min(300, 30 * 2 ** min(4, fails - 1))
				else:
					fails = fw_aborts = hub_aborts = 0
					backoff = mono + AWAKE_AFTER.get(reason, 8)
					if info.get('purpose') in ('tick', 'aod'):
						backoff = mono	# nothing to do: straight back
						quick = True
					# Wi-Fi was up at the sleep and is bound again: give it its window
					if (WIFI_WINDOW_S and not info.get('wifi_kept') and
							info.get('purpose') in ('wifi', 'alarm', 'other') and
							last_wifi.get('before') == 'up' and (WIFI / WIFI_DEV).exists()):
						wifi_wait = (last_wifi.get('bound_at', boottime()), boottime() + WIFI_WINDOW_S)
					if last_dozing and reason in ('rtc', 'other', 'alarm'):
						backoff = mono + max(DOZE_AWAKE_S, AWAKE_AFTER.get(reason, 8))
						window = (mono, time.time(), mono + DOZE_AWAKE_MAX_S)
				if reason in ('hub', 'hub-busy'):
					# boot time: the window counts the sleeps in between
					now = boottime()
					hub_times.append(now)
					while hub_times and now - hub_times[0] > HUB_WINDOW_S:
						hub_times.popleft()
					if len(hub_times) >= HUB_LIMIT:
						log(f'sensor hub keeps the AP awake: {len(hub_times)} in '
						    f'{HUB_WINDOW_S}s, next try in {HUB_BACKOFF_S}s')
						backoff = mono + HUB_BACKOFF_S
						hub_times.clear()
				if reason == 'key':
					# gpio-keys may hand the shell the press itself, which toggles
					# the screen: only light it if that did not
					time.sleep(1)
					if screen_off():
						tell_shell('screen on')
					off_since = None
				last = dict(last=reason, slept=slept,
					    modem_rx=info.get('modem_rx', '').replace(', ', ',').replace(' ', '') or 'none')
				status(state='awake', **last, sleeps=sleeps, wakes=wakes, woke_at=woke_at)
			else:
				status(state='awake', why=why or 'waiting', **last, sleeps=sleeps,
				       wakes=wakes, woke_at=woke_at)
			if time.monotonic() >= summary_at:
				log(totals.line())
				summary_at = time.monotonic() + SUMMARY_S
			# a tick wake goes straight back; a Wi-Fi window is timed closely
			time.sleep(0.1 if quick else 0.5 if wifi_wait else 2)
	finally:
		log(totals.line())


ONCE_IGNORES = ('charger', 'switched off', 'paused')


def once(argv):
	"""zrn-sleepd once [SECONDS] [--ignore-inhibit NAME]...: one sleep now,
	an RTC alarm after SECONDS. A firmware abort is classified and logged
	only; it is tried up to 3 times."""
	global MAX_SLEEP_S
	ignore_inhibits = []
	rest = []
	args = iter(argv)
	for word in args:
		if word == '--ignore-inhibit':
			name = next(args, None)
			if not name:
				sys.exit('--ignore-inhibit needs a NAME')
			ignore_inhibits.append(name)
		else:
			rest.append(word)
	STATE.mkdir(parents=True, exist_ok=True)
	repair_log()
	load_config()
	if rest:
		MAX_SLEEP_S = int(rest[0])
	if not setup():
		sys.exit(1)
	ensure_watch()
	if ignore_inhibits:
		log('once: not counting inhibits', ','.join(ignore_inhibits))
	if not screen_off():
		tell_shell('screen off')
		time.sleep(3)
	for attempt in range(3):
		reason, stat = cycle(ONCE_IGNORES, tuple(ignore_inhibits))
		info = dict(last_sleep)
		charge = ''
		if info.get('slept') is not None:
			charge = (f' (asleep {info["slept"]:.1f}s, charge {mah(info.get("charge_in"))}'
				  f'->{mah(info.get("charge_out"))} mAh)')
		log(f'once: woke: {woke_text(reason, info)} wake_stat={stat:#010x}{charge}')
		if reason == 'alarm':
			log_alarm_wake('once: ')
		if reason == 'fw-abort':
			log(f'once: the firmware gave the sleep up (cause {fw_abort_cause()}): '
			    f'{fw_abort_detail()}')
		if reason not in ('aborted', 'fw-abort', 'alarm-due', 'hub-busy'):
			break
		time.sleep(5)


if __name__ == '__main__':
	cmd = sys.argv[1] if len(sys.argv) > 1 else 'run'
	if cmd == 'enable':
		STATE.mkdir(parents=True, exist_ok=True)
		ENABLED.touch()
		PAUSED.unlink(missing_ok=True)
	elif cmd == 'disable':
		ENABLED.unlink(missing_ok=True)
	elif cmd == 'status':
		print(read(STATUS) or 'not running')
		print('enabled' if ENABLED.exists() else 'disabled')
		if PAUSED.exists():
			until = dict(w.partition('=')[::2] for w in read(PAUSED).split()).get('until', '')
			try:
				left = float(until) - boottime()
				print(f'paused for another {max(0, left) / 60:.0f} min:', read(PAUSED))
			except ValueError:
				print('paused:', read(PAUSED))
	elif cmd == 'log':
		# zrn-sleepd log [N | all]: the last N lines (50), NUL bytes dropped
		arg = sys.argv[2] if len(sys.argv) > 2 else '50'
		show_log(None if arg == 'all' else int(arg))
	elif cmd == 'once':
		once(sys.argv[2:])
	else:
		main()
