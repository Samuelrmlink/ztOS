<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The shape of the phone's stock apns-conf.xml for 310/260 (Samsung
     G960FXXUHFVG4): the entries that matter for T-Mobile and its MVNOs, in
     their order there, with that file's values. The 001/01 entries are made
     up, for a network whose MMS has its own access point and a proxy. -->
<apns version="8">
  <!-- <apn carrier="commented out" mcc="310" mnc="260" apn="wrong" type="default" /> -->
  <apn carrier="T-Mobile Tethering" mcc="310" mnc="260" apn="pcweb.tmobile.com" protocol="IPV4V6" type="dun" mtu="1440" />
  <apn carrier="T-Mobile IMS" mcc="310" mnc="260" apn="ims" bearer_bitmask="14|18" protocol="IPV6" type="ims" mtu="1440" />
  <apn carrier="T-Mobile MMS EPDG" mcc="310" mnc="260" apn="tmus" mmsc="http://mms.msg.eng.t-mobile.com/mms/wapenc" bearer_bitmask="18" mtu="1440" type="mms" protocol="IPV6" />
  <apn carrier="T-Mobile EMERGENCY" mcc="310" mnc="260" apn="" protocol="IPV6" type="Emergency" mtu="1440" />
  <apn carrier="T-Mobile US LTE" mcc="310" mnc="260" apn="fast.t-mobile.com" mmsc="http://mms.msg.eng.t-mobile.com/mms/wapenc" type="default,supl,mms,xcap" protocol="IPV6" roaming_protocol="IP" mtu="1440" />
  <apn carrier="MetroPCS US LTE" mcc="310" mnc="260" apn="fast.metropcs.com" mmsc="http://metropcs.mmsmvno.com/mms/wapenc" type="default,supl,mms,xcap" protocol="IPV6" mtu="1440" mvno_type="gid" mvno_match_data="6D38" />
  <apn carrier="RED POCKET" mcc="310" mnc="260" apn="Wholesale" type="default,supl,mms" protocol="IPV4V6" mmsc="http://wholesale.mmsmvno.com/mms/wapenc" mmsproxy="216.155.165.50" mmsport="8080" mvno_type="gid" mvno_match_data="4201" />
  <apn carrier="Project Fi - T" mcc="310" mnc="260" apn="h2g2" mmsc="http://mmsc1.g-mms.com/mms/wapenc" type="default,mms" protocol="IPV6" mvno_match_data="31026097" mvno_type="IMSI" />
  <apn carrier="Test &amp; Data" mcc="001" mnc="01" apn="test.data" user="u" password="p" authtype="1" type="default,supl" />
  <apn carrier="Test MMS" mcc="001" mnc="01" apn="test.mms" mmsc="http://mmsc.example.invalid:8002/mms" mmsproxy="10.0.0.1" mmsport="8080" type="mms" />
</apns>
