# ztos-waydroid (packages/ztos-waydroid): the fixed actions of Waydroid's root
# helper that the shell, ztos-waydroid-power/-launch and ztos-android run.
# zrn-pushd's two (push, microg) are in its own rule. Nothing else.
@USER@ ALL=(root) NOPASSWD: /usr/local/libexec/ztos-waydroid-recover audio, /usr/local/libexec/ztos-waydroid-recover prepare, /usr/local/libexec/ztos-waydroid-recover ready, /usr/local/libexec/ztos-waydroid-recover recover, /usr/local/libexec/ztos-waydroid-recover freeze, /usr/local/libexec/ztos-waydroid-recover unfreeze, /usr/local/libexec/ztos-waydroid-recover display on, /usr/local/libexec/ztos-waydroid-recover display off, /usr/local/libexec/ztos-waydroid-recover settings, /usr/local/libexec/ztos-waydroid-recover install *, /usr/local/libexec/ztos-waydroid-recover remove *, /usr/local/libexec/ztos-waydroid-recover close *
