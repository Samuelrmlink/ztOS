#!/bin/bash
# zrn-charge: the charging policy for the MAX77705 (Galaxy S9).
#
# The kernel charges at whatever limits it is given; this decides them, from
# what is plugged in and from the battery's temperature, as Samsung's own
# system did (its DT `cable-info` and battery nodes; charging/wired-stock.md
# §0.7 and §5, charging/wireless.md §2.3). Limits in mA, input / into the battery:
#
#	sdp (a computer's port)				 500 / 550
#	cdp (a charging port)				1500 / 1500
#	dcp, samsung-2a, apple-2a, apple-12w, dcp-3a	1800 / 2100	(stock: "TA")
#	apple-1a					1000 / 1000
#	apple-0.5a, dcd-timeout, unknown, nothing	 500 / 500
#	rp-1.5a (Type-C Rp 1.5 A)			1500 / 1500
#	rp-3a   (Type-C Rp 3 A)				3000 / 2150
#	afc-9v, qc2-9v at 9 V				1650 / 2150	(at 5 V: as dcp)
#	pd						the source's current, <= 3000 and <= 15 W / 2150
#	wireless (Qi 5 V)				 900 / 1200	(10 V: 650 / 1200)
#
# On top of that, from the battery thermistor (tenths of a degree; zrn-therm,
# power/thermistors/: the gauge's own temp is not measured), with stock's
# hysteresis:
#	>= 50 C stop, resume at 45;  <= 0 C stop, resume at 5
#	>= 41 C 1090 mA (700 on a pad) and a 4.15 V float, back at 39;  <= 5 C 700 mA
#	and 4.15 V, back at 10;  <= 15 C 700 mA, back at 20. Where the charger's float
#	can't be set, "4.15 V" is kept by stopping at 4.15 V and resuming below 4.0 V.
#	9 V only below 41 C; at 9 V with the screen on, 500 mA in / 1000 (stock SIOP).
#	Entering the 41 C or the 5 C step, charging stops, and starts again (at
#	4.15 V) only under 4.00 V, and so again each time it is full there (stock).
# And from the other thermistors (power/THERMAL.md §3):
#	USB connector >= 80 C: stopped, 5 V, 100 mA in; back at 75
#	charger >= 46 C: AFC/QC at 9 V 1000 / 1250 mA, PD 5 V and 1800 mA in; back at 44
#	battery >= 42 C with the charger >= 50 C: in ~338 mA at 5 V (stock's
#	mix_limit), until the battery is at 39 C
# The float otherwise: 4.24 V once Samsung's own cycle count (EFS
# batt_discharge_level / 100, read only) is 1000 or more, stock's age step for
# this battery; 4.35 V below it or if the count can't be read (owner,
# 2026-11-12; power/battery-cycles.md). The kernel takes it through the
# charger's constant_charge_voltage (patch-max77705-charger.py).
#
# The charger type comes from the max77705-usbc power supply where the kernel
# has one (charger_type, else usb_type and current_max); on a kernel without it,
# from the MUIC's BC_STATUS and the Type-C CC_STATUS0 over I2C (plain status
# registers; nothing is written). AICL is the kernel's: once the input limit has
# been cut below what was asked (or the kernel reports a cut in
# $AICL_NAME), it is not raised again while the same charger stays in.
# Where the kernel ramps the input itself, the limit written is its ceiling,
# written once per decision and never "corrected" from what it reads back.
# 9 V is asked for through the usbc device's hv_enable, and only when allowed;
# either way the input limit drops to 500 mA first, and the new limit is
# written once usbc's voltage_now has moved.
#
# Over-current trips (the driver's count, or on a kernel without it CHGIN
# dropping out and back within 5 s at 1 A or more) and PD anomalies (a Hard
# Reset, then other source caps) are remembered per charger in /var/lib/
# zrn-charge for 30 days: a charger that tripped gets at most its trip limit
# less 200 mA (500 mA at least) from then on, and 5 V only if the trip was at
# 9 V or it had a PD anomaly. A PD anomaly, or a second Hard Reset on one plug,
# also means 5 V and at most 1500 mA (or the caps' 5 V current) for the rest
# of that plug. Other caps without a Hard Reset are just followed.
#
# It also tells zrn-ledd, which owns the front LED, what the battery is doing:
# charging, full, low (discharging at 15 % or less) or none.
#
#	zrn-charge --daemon	the service: waits for power-supply uevents (and a
#				slow timer, for the temperature), one pass per burst
#	zrn-charge		one pass (zboot-charge-hold, early in the boot); if
#				the daemon runs, it just asks it for one
#	zrn-charge --show	the chargers remembered (see MEM below)
#	zrn-charge --forget FINGERPRINT|all
#
# ZRN_CHARGE_ROOT puts every path under another directory (tests);
# ZRN_CHARGE_I2CGET and ZRN_CHARGE_MONITOR replace i2cget and udevadm monitor.
R=${ZRN_CHARGE_ROOT:-}
PS=$R/sys/class/power_supply
C=$PS/max77705-charger		# CHGIN limit, charge current, behaviour
W=$PS/max77705-wireless		# WCIN: online, input limit
U=$PS/max77705-usbc		# what the source is
B=$PS/max170xx_battery
RX=$PS/p9320-wireless		# the receiver: its output voltage, if it says
TH=$R/sys/kernel/zrn_therm	# the thermistors, from zrn-therm: fresh or unreadable
AGE=$R/run/android/mnt/vendor/efs/FactoryApp/batt_discharge_level	# Samsung's count x 100 (read only)
AGE_CYCLES=1000 AGE_FLOAT=4240	# stock's battery,age_data step for this battery
DRM=$R/sys/class/drm
LED=$R/run/zrn-led/charge
RUN=$R/run/zrn-charge
UPTIME=$R/proc/uptime
I2CGET=${ZRN_CHARGE_I2CGET:-i2cget}
MONITOR=${ZRN_CHARGE_MONITOR:-udevadm monitor --kernel --subsystem-match=power_supply}
AICL_NAME=input_current_limit_aicl	# on the charger: uA, 0 = AICL has not cut it
# The kernel's input ramp, where it has one: input_current_limit is then a
# ceiling, written once per decision; the kernel starts low, steps up while VBUS
# holds, backs off on AICL or a dip, and holds what it found for the plug. These
# read-only attributes on the charger say so (and are logged); without them the
# limit is set and watched here, as before.
RAMP_EFFECTIVE=input_current_limit_effective	# uA, what applies now
RAMP_FOUND=input_current_limit_found		# uA, what the ramp settled on
RAMP_STATE=input_current_ramp			# the ramp's state, a word
# Over-current trips the charger driver counts (contract.md), and the usbc
# driver's PD source caps, Hard Reset count and "caps changed after a Hard
# Reset" count (on usbc or its device; not named in the contract yet, these
# are the names asked for). Without the trip count a trip is a CHGIN drop-out.
TRIP_COUNT=input_current_trips			# chargers cutting VBUS, this boot
TRIP_LIMIT=input_current_trip_limit		# uA in force at the last trip
TRIP_VOLTAGE=input_current_trip_voltage		# uV at the last trip, 0 = unknown
PD_CAPS=pd_source_caps				# the source's PDOs, "mV:mA mV:mA ..."
LOW_HV_PCT=15					# below it, a PD 5 V x 3 A charger stays at 5 V
PD_HARD_RESETS=pd_hard_resets			# a count
PD_CAPS_REDUCED=pd_caps_reduced_after_hard_reset	# a count
# What each charger did before, per fingerprint (charger_type, usb_type and
# the PD source caps: what the charger says it is, nothing private), one file
# each: "held tripped 5v-only pd-anomaly last-seen fingerprint".
MEM=$R/var/lib/zrn-charge
MEM_DAYS=30	# forgotten when not seen for this long
HELD_S=60	# a limit that stayed this long "held"
LOW=15		# per cent: at this or below, off the charger, the battery is low
REPLUG_S=5	# out for less than this is the same plug (VBUS drop-outs keep the AICL cut)
PREPARE_S=10	# 500 mA while a source is asked for 9 V, at most this long
DEBOUNCE=0.5	# seconds of quiet that end a burst of uevents

get() {	# file: its first line in REPLY; false if there is none
	REPLY=
	[ -r "$1" ] || return 1
	read -r REPLY < "$1" 2>/dev/null || [ -n "$REPLY" ]
}
num() { get "$1" && [[ $REPLY =~ ^-?[0-9]+$ ]]; }
sel() {	# a sysfs choice list, "a [b] c": the chosen one
	get "$1" || return 1
	case $REPLY in *\[*\]*) REPLY=${REPLY#*\[}; REPLY=${REPLY%%\]*} ;; esac
}
cget() { get "$C/$1" || get "$C/device/$1"; }
uget() { get "$U/$1" || get "$U/device/$1"; }
put() {
	[ -n "${ZRN_CHARGE_TRACE:-}" ] && echo "${1#$PS/} $2" >> "$ZRN_CHARGE_TRACE"	# tests: the order
	[ -e "$1" ] && { echo "$2" > "$1"; } 2>/dev/null
}
now() { get "$UPTIME"; NOW=${REPLY%%.*}; NOW=${NOW:-0}; EPOCH=${ZRN_CHARGE_EPOCH:-$EPOCHSECONDS}; }
min() { [ "$2" -lt "${!1}" ] && printf -v "$1" %d "$2"; }

table() {	# type: lin, lchg (mA), stock's cable-info
	case $1 in
	sdp)		lin=500  lchg=550 ;;
	cdp|rp-1.5a)	lin=1500 lchg=1500 ;;
	dcp|samsung-2a|apple-2a|apple-12w|dcp-3a) lin=1800 lchg=2100 ;;
	apple-1a)	lin=1000 lchg=1000 ;;
	rp-3a|pd)	lin=3000 lchg=2150 ;;
	afc-9v|qc2-9v)	lin=1650 lchg=2150 ;;
	wireless)	lin=900  lchg=1200 ;;
	wireless-hv)	lin=650  lchg=1200 ;;
	*)		lin=500  lchg=500 ;;
	esac
}

i2c() {	# register of the USB-C MCU (0x25): a plain status read, or 0
	REPLY=$($I2CGET -f -y 1 0x25 "$1" 2>/dev/null)
	[[ $REPLY =~ ^0x[0-9a-fA-F]+$ ]] || REPLY=0
}

detect() {	# src (none, wired, wireless), type, cmax (mA, 0 = not said), volt (mV)
	local wired=0 wl=0 bc cc chg pr r a
	type=none cmax=0 volt=5000 utype= caps= wl_busy=0
	get "$C/online" && [ "$REPLY" = 1 ] && wired=1
	get "$W/online" && [ "$REPLY" = 1 ] && wl=1
	if [ -d "$U" ]; then
		get "$U/online" && [ "$REPLY" = 1 ] && wired=1
		if [ $wired = 1 ]; then
			num "$U/current_max" && cmax=$((REPLY / 1000))
			num "$U/voltage_now" && [ "$REPLY" -gt 0 ] && volt=$((REPLY / 1000))
			sel "$U/usb_type" && utype=$REPLY
			uget $PD_CAPS && caps=$REPLY
			get "$U/charger_type"; type=$REPLY
			if [ -z "$type" ]; then
				case $utype in
				SDP) type=sdp ;; CDP) type=cdp ;; DCP) type=dcp ;; PD*) type=pd ;;
				C) if [ $cmax -ge 3000 ]; then type=rp-3a
				   elif [ $cmax -ge 1500 ]; then type=rp-1.5a; else type=unknown; fi ;;
				*) type=unknown ;;
				esac
			fi
		fi
	elif [ $wired = 1 ]; then
		# today's kernel: BC_STATUS (VBUSDet 7, PrChgTyp 5:3, DCDTmo 2, ChgTyp 1:0)
		# and CC_STATUS0 (CCIStat 5:4: Rp 1 = 0.5 A, 2 = 1.5 A, 3 = 3 A)
		i2c 0x08; bc=$REPLY
		i2c 0x0a; cc=$REPLY
		chg=$((bc & 3)) pr=$((bc >> 3 & 7))
		case $pr in
		1) type=samsung-2a ;; 2) type=apple-0.5a ;; 3) type=apple-1a ;;
		4) type=apple-2a ;; 5) type=apple-12w ;; 6) type=dcp-3a ;;
		esac
		# stock: a proprietary signature on SDP/CDP is an "unofficial TA"; DCP is TA
		case $chg in
		0) type=unknown ;;
		3) [ $pr = 6 ] || type=dcp ;;
		2) [ $type = none ] && type=cdp ;;
		1) [ $type = none ] && { [ $((bc >> 2 & 1)) = 1 ] && type=dcd-timeout || type=sdp; } ;;
		esac
		# a Type-C source's Rp current, where it gives more (stock: not for CDP)
		case $((cc >> 4 & 3)) in 3) r=rp-3a ;; 2) r=rp-1.5a ;; *) r= ;; esac
		if [ -n "$r" ] && [ $type != cdp ]; then
			table $r; a=$lin; table $type
			[ $a -gt $lin ] && type=$r
		fi
	fi
	if [ $wired = 1 ]; then src=wired
	elif [ $wl = 1 ]; then
		src=wireless type=wireless
		if get "$RX/hv_state"; then
			# the receiver caps WCIN itself while it changes voltage
			case $REPLY in 10v) type=wireless-hv ;; prepare|stepdown) wl_busy=1 ;; esac
		elif num "$RX/voltage_now" && [ "$REPLY" -ge 7500000 ]; then
			type=wireless-hv
		fi
	else src=none
	fi
}

screen_on() {	# what the person sees: the shell's own screen state (zrnperfd's status)
	# first, since the always-on display keeps the output enabled with the
	# screen "off"; else as zrn-sleepd sees it, off only when every connector
	# says disabled
	local f seen=0
	if [ -r "$R/run/zrnperfd.status" ]; then
		while read -r f; do
			case $f in screen=off) return 1 ;; screen=on) return 0 ;; esac
		done < "$R/run/zrnperfd.status"
	fi
	for f in "$DRM"/card*-*/enabled; do
		get "$f" || continue
		seen=1
		[ "$REPLY" = disabled ] || return 0
	done
	[ $seen = 0 ]
}

led() {	# what the front LED should show: zrn-ledd draws it. Only when it changes.
	get "$LED"
	[ "$REPLY" = "$1" ] || { echo "$1" > "$LED"; } 2>/dev/null
}
led_now() {	# online: 1 if a charger is in
	local level=100
	num "$B/capacity" && level=$REPLY
	get "$B/status"
	case $REPLY in
	Charging) led charging ;;
	Full) led full ;;
	Discharging)
		# Plugged in counts as charging: on a computer's port the phone can use more
		# than the port gives, and the gauge flips between the two with the load.
		# Low stays low: on such a port it's still running down.
		if [ "$level" -le $LOW ]; then led low
		elif [ "$1" = 1 ]; then led charging
		else led none; fi ;;
	*)	if [ "$1" = 1 ] && [ "$level" -ge 95 ]; then led full
		elif [ "$level" -le $LOW ] && [ "$1" != 1 ]; then led low
		else led none; fi ;;
	esac
}

setlim() {	# input file, the variable holding what was last written there,
		# input mA, charge mA. An input limit is written once per decision (our
		# own write raises another uevent); without the kernel's ramp, the
		# CHGIN limit is also compared with what it reads back. Raising, the
		# battery side goes first.
	local f=$1 v=$2 cur=${!2} tol=0 d
	if [ $ramp = 0 ] && [ "$f" = "$C/input_current_limit" ] && num "$f"; then
		cur=$((REPLY / 1000)) tol=60	# the read-back is in 25 mA codes
	elif [ "$f" = "$W/input_current_limit" ] && num "$f"; then
		cur=$((REPLY / 1000)) tol=24	# the WCIN ceiling, which the receiver also sets
	fi
	d=$((cur - $3)); d=${d#-}
	if [ $3 -gt $cur ]; then
		setone "$C/constant_charge_current" $4
		[ $d -gt $tol ] && put "$f" $(($3 * 1000))
	else
		[ $d -gt $tol ] && put "$f" $(($3 * 1000))
		setone "$C/constant_charge_current" $4
	fi
	printf -v $v %d $3
}
setone() {
	local cur=0 d
	num "$1" && cur=$((REPLY / 1000))
	d=$((cur - $2)); d=${d#-}
	[ $d -gt 49 ] && put "$1" $(($2 * 1000))	# the read-back is in 50 mA codes
}

mem_file() { REPLY=$MEM/${1//[^A-Za-z0-9._:,+-]/_}; }
mem_get() {	# fingerprint: m_held m_trip (mA, 0 = none) m_hv m_anom m_seen; false if unknown
	m_held=0 m_trip=0 m_hv=0 m_anom=0 m_seen=0
	[ -n "$1" ] || return 1
	mem_file "$1"
	[ -r "$REPLY" ] && read -r m_held m_trip m_hv m_anom m_seen _ < "$REPLY" 2>/dev/null &&
		[[ "$m_held $m_trip $m_hv $m_anom $m_seen" =~ ^[0-9]+\ [0-9]+\ [01]\ [01]\ [0-9]+$ ]] && return 0
	m_held=0 m_trip=0 m_hv=0 m_anom=0 m_seen=0
	return 1
}
mem_put() {	# fingerprint: write what m_* say
	[ -n "$1" ] || return 0
	[ -d "$MEM" ] || mkdir -p "$MEM" 2>/dev/null
	mem_file "$1"
	{ echo "$m_held $m_trip $m_hv $m_anom $m_seen $1" > "$REPLY"; } 2>/dev/null
}
mem_age() {	# forget the chargers not seen for MEM_DAYS
	local f s
	for f in "$MEM"/*; do
		[ -f "$f" ] || continue
		read -r _ _ _ _ s _ < "$f" 2>/dev/null
		[[ $s =~ ^[0-9]+$ ]] && [ $((EPOCH - s)) -le $((MEM_DAYS * 86400)) ] && continue
		rm -f "$f"
	done
}
bumped() {	# state variable, a count read now: true if it went up since the last look
	local v=$1
	if [ -z "${!v}" ] || [ $2 -lt ${!v} ]; then printf -v $v %d $2; return 1; fi
	[ $2 -gt ${!v} ] || return 1
	printf -v $v %d $2
}
pd_back() {	# why, 1 to remember it: 5 V and at most 1500 mA (or the caps' 5 V
		# current, if lower) until unplugged
	local p ma
	anom=1 anom_cap=1500
	for p in $caps; do
		ma=${p#*:}; ma=${ma%%[!0-9]*}; p=${p%%:*}; p=${p%%[!0-9]*}
		[ -n "$p" ] && [ -n "$ma" ] && [ $p -le 5500 ] && [ $ma -lt $anom_cap ] && anom_cap=$ma
	done
	if [ $2 = 1 ] && [ -n "$sess_fp" ]; then
		mem_get "$sess_fp"; m_anom=1 m_seen=$EPOCH; mem_put "$sess_fp"
	fi
	echo "<4>zrn-charge: PD ANOMALY, worth investigating: ${sess_fp:-the source}: $1; 5 V and at most $anom_cap mA until it is unplugged"
}
trip() {	# fingerprint, limit mA, 1 if at 9 V, how it was seen: remember, and say so loudly
	local c=$(($2 - 200)) t
	[ $c -lt 500 ] && c=500
	if mem_get "$1" || [ -n "$1" ]; then
		[ $m_trip = 0 ] || [ $2 -lt $m_trip ] && m_trip=$2
		[ $3 = 1 ] && m_hv=1
		m_seen=$EPOCH; mem_put "$1"
	fi
	t="CHARGER TRIP: ${1:-an unknown charger} cut out at $2 mA"
	[ $3 = 1 ] && t+=" at 9 V"
	t+=" ($4); from now on it gets at most $c mA"
	[ $3 = 1 ] && t+=", and 5 V only"
	echo "<3>zrn-charge: $t"
}

# what one pass remembers for the next (the daemon keeps it; a lone pass reads it)
STATE="lowdone redrop src_was key_was cap win ceil wceil off_since plug_at settle hot_stop cold_stop warm cold cool vhold hv_at logged
	sess_fp held_val held_since trips_seen hr_seen reduced_seen hr_sess hr_caps caps_was anom anom_cap
	last_fp last_in last_hv usb_hot chg_hot mix swell swell_hold"
src_was=none key_was= cap=0 win=0 ceil=0 wceil=0 off_since=0 plug_at=0 settle=0
lowdone=0 hot_stop=0 cold_stop=0 warm=0 cold=0 cool=0 vhold=0 hv_at=0 logged=
redrop=0 sess_fp= held_val=0 held_since=0 trips_seen= hr_seen= reduced_seen= hr_sess=0 hr_caps= caps_was=
anom=0 anom_cap=1500
last_fp= last_in=0 last_hv=0
usb_hot=0 chg_hot=0 mix=0 swell=0 swell_hold=0
load() { [ -r "$RUN/state" ] && . "$RUN/state"; }
save() {
	local v
	{ for v in $STATE; do printf '%s=%q\n' $v "${!v}"; done; } > "$RUN/state" 2>/dev/null
}

pass() {	# look, decide, write; nap: when to look again without an event (s)
	local T=250 tknown=0 mv in chg why= stop=0 hvbus=0 hvok=1 hvf= hv=0 want=0 rb a f t s key nominal fl bmax
	local ramp=0 rs= n p ma ct
	# (all builtins: no process is started, but for i2cget on the old kernel)
	now; detect

	# a plug session: from a charger in until out for REPLUG_S or more
	if [ $src = none ]; then
		[ "$off_since" = 0 ] && off_since=$NOW
		redrop=1	# a quick return may still be another charger (a cable swap)
	else
		if [ "$src_was" = none ] && [ $((NOW - off_since)) -ge $REPLUG_S ]; then
			cap=0 win=0 ceil=0 wceil=0 hv_at=0 plug_at=$NOW settle=$((NOW + 15))
			sess_fp= held_val=0 held_since=0 anom=0 anom_cap=1500 hr_sess=0 hr_caps= caps_was=
			lowdone=0
			mem_age
		elif [ "$src_was" = none ] && [ $src = wired ] && [ -n "$last_fp" ] &&
		     [ $last_in -ge 1000 ] && ! cget $TRIP_COUNT; then
			# without the driver's count: CHGIN gone and back within REPLUG_S
			# at 1 A or more is taken for an over-current trip
			trip "$last_fp" $last_in $last_hv "the input dropped out for $((NOW - off_since)) s"
		fi
		off_since=0
	fi
	# the driver's own trip count
	if cget $TRIP_COUNT && [[ $REPLY =~ ^[0-9]+$ ]]; then
		n=$REPLY
		if [ -z "$trips_seen" ] || [ $n -lt $trips_seen ]; then trips_seen=$n
		elif [ $n -gt $trips_seen ]; then
			trips_seen=$n p=$last_in a=$last_hv
			cget $TRIP_LIMIT && [[ $REPLY =~ ^[0-9]+$ ]] && p=$((REPLY / 1000))
			cget $TRIP_VOLTAGE && [[ $REPLY =~ ^[0-9]+$ ]] && [ $REPLY -gt 0 ] && { a=0; [ $REPLY -ge 8000000 ] && a=1; }
			trip "${sess_fp:-$last_fp}" $p $a "the charger's over-current count, now $n"
		fi
	fi
	[ "$src" != "$src_was" ] && settle=$((NOW + 10))	# the gauge's status lags the plug
	src_was=$src
	[ $volt -ge 7000 ] && hvbus=1
	[ -e "$C/$RAMP_STATE" ] || [ -e "$C/$RAMP_FOUND" ] || [ -e "$C/$RAMP_EFFECTIVE" ] && ramp=1
	key="$src $type $hvbus"
	if [ $src != none ]; then	# another source or voltage: the AICL cut is gone
		[ "$key" != "$key_was" ] && cap=0
		key_was=$key
	fi
	# the charger's fingerprint, fixed at the first type it was known as on this
	# plug: type, usb_type and the voltages of its PDOs up to 9 V. Not their
	# currents: a multi-port charger shares its current between its ports, and
	# a throttling one lowers it, and it is still the same charger.
	# A different type after a drop-out within REPLUG_S is a swapped charger, not
	# the same one coming back: a new session (a trip keeps its type, so stays).
	if [ $redrop = 1 ] && [ $src != none ] && [ $type != unknown ]; then
		if [ -n "$sess_fp" ] && [ "${sess_fp%%+*}" != "$type" ]; then
			cap=0 win=0 ceil=0 wceil=0 hv_at=0 plug_at=$NOW settle=$((NOW + 15))
			sess_fp= held_val=0 held_since=0 anom=0 anom_cap=1500 hr_sess=0 hr_caps= caps_was=
			lowdone=0
		fi
		redrop=0
	fi
	if [ $src = wired ] && [ -z "$sess_fp" ] && [ $type != unknown ]; then
		sess_fp=$type
		[ -n "$utype" ] && sess_fp+="+$utype"
		if [ -n "$caps" ]; then
			a=
			for p in $caps; do
				p=${p%%:*}; p=${p%%[!0-9]*}
				[ -n "$p" ] && [ $p -le 9000 ] && [[ ",$a," != *",$((p / 1000))V,"* ]] && a+=",$((p / 1000))V"
			done
			[ -n "$a" ] && sess_fp+="+${a#,}"
		fi
		mem_get "$sess_fp"; m_seen=$EPOCH; mem_put "$sess_fp"
	fi
	# PD. A Hard Reset is logged, always; one followed by other source caps is
	# the anomaly (5 V, little current, remembered for the charger), and so is a
	# second one on the same plug (5 V, little current, not remembered). Other
	# caps without a Hard Reset are normal (throttling, or a multi-port charger
	# sharing): followed, the ceiling from current_max as ever, one line.
	n=0
	if uget $PD_HARD_RESETS && [[ $REPLY =~ ^[0-9]+$ ]] && bumped hr_seen $REPLY && [ $src = wired ]; then
		n=1 hr_sess=$((hr_sess + 1)) hr_caps=${caps_was:--}
		echo "<4>zrn-charge: PD Hard Reset (number $hr_sess on this plug): ${sess_fp:-the source} at $((volt / 1000)) V, in $last_in mA, caps ${caps:-not known}"
		[ $hr_sess -ge 2 ] && pd_back "a second Hard Reset on this plug" 0
	fi
	a=0
	if uget $PD_CAPS_REDUCED && [[ $REPLY =~ ^[0-9]+$ ]]; then
		bumped reduced_seen $REPLY && a=1
	elif [ -n "$hr_caps" ] && [ -n "$caps" ] && [ "$caps" != "$hr_caps" ]; then
		a=1	# no count from the driver: the caps seen to change after the reset
	fi
	if [ $a = 1 ] && [ $src = wired ]; then
		pd_back "other source caps after a Hard Reset (before: ${hr_caps#-}; after: ${caps:-not known})" 1
		hr_caps=
	elif [ $n = 0 ] && [ $src = wired ] && [ -n "$caps" ] && [ -n "$caps_was" ] && [ "$caps" != "$caps_was" ]; then
		echo "zrn-charge: PD source caps changed, followed: $caps_was -> $caps"
	elif [ $n = 0 ] && [ "$caps" = "$hr_caps" ]; then
		hr_caps=	# the same caps after the reset
	fi
	[ -n "$caps" ] && caps_was=$caps

	# the battery's temperature, with stock's hysteresis
	# unknown (no zrn-therm, an ADC error, a reading gone stale) counts as hot
	# for the voltage: 5 V only, on a cable and on a pad. 25 C for the limits.
	# Never the gauge's temp: nothing measures it (power/battery-cycles.md).
	num "$TH/battery" && { T=$REPLY; tknown=1; }
	[ $T -ge 500 ] && hot_stop=1;	[ $T -le 450 ] && hot_stop=0
	[ $T -le 0 ] && cold_stop=1;	[ $T -ge 50 ] && cold_stop=0
	[ $T -ge 410 ] && warm=1;	[ $T -le 390 ] && warm=0
	[ $T -le 50 ] && cold=1;	[ $T -ge 100 ] && cold=0
	[ $T -le 150 ] && cool=1;	[ $T -ge 200 ] && cool=0
	# The USB connector and the charger thermistors, as stock reads them
	# (power/THERMAL.md §3): temp_highlimit on the connector, 80 C cuts
	# charging, 75 C lets it go; chg_high_temp on the charger, 46 C limits the
	# input, 44 C lets it go. An unknown reading keeps the state it had.
	num "$TH/usb" && { [ $REPLY -ge 800 ] && usb_hot=1; [ $REPLY -le 750 ] && usb_hot=0; }
	ct=
	num "$TH/charger" && { ct=$REPLY; [ $ct -ge 460 ] && chg_hot=1; [ $ct -le 440 ] && chg_hot=0; }
	# stock's mix_limit: battery >= 42 C with the charger >= 50 C, held while
	# the battery stays above 39 C
	if [ $tknown = 1 ]; then
		if [ $mix = 1 ]; then [ $T -le 390 ] && mix=0
		elif [ -n "$ct" ] && [ $T -ge 420 ] && [ $ct -ge 500 ]; then mix=1; fi
	fi

	table $type; in=$lin chg=$lchg
	case $type in
	afc-9v|qc2-9v) [ $hvbus = 1 ] || { table dcp; in=$lin chg=$lchg; } ;;
	pd)	[ $cmax -gt 0 ] && min in $cmax
		[ $hvbus = 1 ] && min in $((15000000 / volt)) ;;
	esac
	[ $src = none ] && in=500 chg=500

	if [ $warm = 1 ]; then
		if [ $src = wireless ]; then min chg 700; else min chg 1090; fi
		why+=" warm"
	elif [ $cold = 1 ]; then min chg 700; why+=" cold"
	elif [ $cool = 1 ]; then min chg 700; why+=" cool"
	fi
	# the float: 4.15 V while swelling is a risk, else the battery's own, or
	# stock's aged step once Samsung's count says so
	bmax=4350; num "$B/constant_charge_voltage_max" && bmax=$((REPLY / 1000))
	nominal=$bmax
	num "$AGE" && [ $((REPLY / 100)) -ge $AGE_CYCLES ] && [ $AGE_FLOAT -lt $nominal ] && nominal=$AGE_FLOAT
	f=$nominal; [ $((warm | cold)) = 1 ] && f=4150
	fl=$bmax; num "$C/constant_charge_voltage" && fl=$((REPLY / 1000))
	[ $fl != $f ] && put "$C/constant_charge_voltage" $((f * 1000)) &&
		num "$C/constant_charge_voltage" && fl=$((REPLY / 1000))
	if [ $f -lt $bmax ] && [ $fl -gt $f ]; then
		# can't be set (an older kernel): stop at the float, go on 150 mV
		# below it, as stock recharges
		mv=0; num "$B/voltage_now" && mv=$((REPLY / 1000))
		[ $mv -ge $f ] && vhold=1
		[ $mv -lt $((f - 150)) ] && vhold=0
	else
		vhold=0
	fi
	# Stock's swelling steps (>= 41 C, <= 5 C) stop charging first, and charge
	# again at 4.15 V only once the battery is under 4.00 V; full there, the
	# same again (swelling_*_rechg_voltage). Voltage unreadable: no hold.
	if [ $((warm | cold)) = 1 ]; then
		mv=0; num "$B/voltage_now" && mv=$((REPLY / 1000))
		[ $swell = 0 ] && swell=1 swell_hold=1
		get "$B/status"; [ "$REPLY" = Full ] && swell_hold=1
		[ $mv -lt 4000 ] && swell_hold=0
	else
		swell=0 swell_hold=0
	fi
	[ $swell_hold = 1 ] && stop=1 why+=" until under 4000 mV"
	[ $hot_stop = 1 ] && stop=1 why+=" too hot"
	[ $cold_stop = 1 ] && stop=1 why+=" too cold"
	[ $vhold = 1 ] && stop=1 why+=" at $f mV"
	[ $((warm | hot_stop | cold_stop)) = 1 ] && hvok=0
	[ $tknown = 1 ] || hvok=0
	# held at 5 V by hand (a new driver on trial): touch /etc/zrn-charge/no-hv
	[ -e "$R/etc/zrn-charge/no-hv" ] && [ $hvok = 1 ] && { hvok=0; why+=" 9 V off by hand"; }
	# Battery under LOW_HV_PCT on a PD charger whose 5 V already gives the full
	# 15 W (5 V x 3 A): stay at 5 V, stock's choice, so there's no switch (and no
	# few seconds at 500 mA while the input ramps up again) when a few percent is
	# all that keeps the phone on. From LOW_HV_PCT on, 9 V: the same charging
	# speed, a bit more efficient, and less lost in the cable. Either works; this
	# only picks when. It never switches down, and once 9 V is allowed it stays
	# so for the plug (lowdone), so it can't flap. AFC/QC2 aren't affected.
	if [ $src = wired ] && [ "$type" = pd ] && [ $lowdone = 0 ] && [ $hvok = 1 ] && [ $hvbus = 0 ]; then
		local pc full5=0 lvl=100
		for pc in $caps; do
			case $pc in 5000:*) [ "${pc#5000:}" -ge 3000 ] 2>/dev/null && { full5=1; break; } ;; esac
		done
		num "$B/capacity" && lvl=$REPLY
		if [ $full5 = 1 ] && [ $lvl -lt $LOW_HV_PCT ]; then
			hvok=0; why+=" 5 V while under $LOW_HV_PCT %"
		else
			lowdone=1
		fi
	fi

	if [ $src = wired ]; then
		if [ $hvbus = 1 ] && screen_on; then min in 500; min chg 1000; why+=" screen on"; fi
		# AICL, without the kernel's ramp: its own word for the cut, or the limit
		# found below what was asked. Not raised again for this plug.
		if [ $ramp = 0 ]; then
			num "$C/$AICL_NAME" && [ "$REPLY" -gt 0 ] &&
				{ a=$((REPLY / 1000)); [ $cap = 0 ] || [ $a -lt $cap ] && cap=$a; }
			rb=0; num "$C/input_current_limit" && rb=$((REPLY / 1000))
			if [ $win -gt 0 ] && [ $rb -gt 0 ] && [ $rb -lt $((win - 60)) ]; then
				a=$rb; [ $a -lt 300 ] && a=300	# stock's floor
				[ $cap = 0 ] || [ $a -lt $cap ] && cap=$a
			fi
			[ $cap -gt 0 ] && [ $in -gt $cap ] && { in=$cap; why+=" aicl"; }
		else
			get "$C/$RAMP_STATE" && rs=$REPLY
		fi
		# what this charger did before: below its trip, and 5 V only after a
		# trip at 9 V or a PD anomaly
		if mem_get "$sess_fp"; then
			if [ $m_trip -gt 0 ]; then
				a=$((m_trip - 200)); [ $a -lt 500 ] && a=500
				[ $in -gt $a ] && { in=$a; why+=" tripped at $m_trip before"; }
			fi
			[ $((m_hv | m_anom)) = 1 ] && [ $hvok = 1 ] && { hvok=0; why+=" 5 V only"; }
		fi
		if [ $anom = 1 ]; then
			hvok=0; min in $anom_cap; why+=" pd anomaly"
		fi
		# the charger hot: stock's sec_bat_check_afc_temp (AFC/QC at 9 V: in
		# 1000, charge 1250) and sec_bat_check_pdic_temp (PD steps down to its
		# 5 V PDO, at most nv_charge_power / 5 V = 1800 mA); 5 V cables: nothing
		if [ $chg_hot = 1 ]; then
			case $type in
			afc-9v|qc2-9v) [ $hvbus = 1 ] && { min in 1000; min chg 1250; why+=" charger hot"; } ;;
			pd)	hvok=0; min in 1800; why+=" charger hot" ;;
			esac
		fi
		# both hot: stock's mix_limit, input = 4.35 V x (topoff 300 + 50 mA) /
		# (0.9 x the bus voltage), at most 350 mA
		if [ $mix = 1 ]; then
			a=$((volt / 1000)); [ $a -lt 5 ] && a=5
			min in $((4350 * 350 / (a * 90) / 10)); why+=" battery and charger hot"
		fi
	fi
	# the connector at 80 C: no charging, 5 V and the least input there is
	# (stock turns the buck off; here the input drops to 100 mA)
	if [ $usb_hot = 1 ] && [ $src != none ]; then
		stop=1 hvok=0; min in 100; why+=" usb connector hot"
	fi

	# 9 V: asked for through hv_enable; going back, the input limit drops first
	for f in "$U/hv_enable" "$U/device/hv_enable"; do [ -e "$f" ] && { hvf=$f; break; }; done
	if [ -n "$hvf" ]; then
		get "$hvf"; [ "$REPLY" = 1 ] && hv=1
		[ $src = wired ] && [ $hvok = 1 ] && case $type in
			sdp|cdp|dcd-timeout|unknown|apple-*|rp-*) ;;
			*) want=1 ;;
		esac
		if [ $hv != $want ]; then
			# a voltage change: a safe 5 V limit first (stock's PREPARE_TA), then
			# the switch; the new limit only once the bus has moved
			[ $src = wired ] && { put "$C/input_current_limit" 500000; ceil=500; }
			put "$hvf" $want; hv=$want hv_at=$NOW settle=$((NOW + PREPARE_S))
		fi
		[ $src = none ] && hv_at=0
		if [ $hv_at -gt 0 ] && [ $hvbus != $hv ] && [ $((NOW - hv_at)) -lt $PREPARE_S ]; then
			if [ $hv = 1 ]; then min in 500; min chg 500; why+=" asking for 9 V"
			else min in 500; why+=" leaving 9 V"; fi
		fi
	fi

	# 10 V on a pad: the receiver's hv_enable, only on a pad and when the
	# temperature allows (it has gates of its own); off at any wired attach
	if [ -e "$RX/hv_enable" ]; then
		a=0; [ $src = wireless ] && [ $hvok = 1 ] && a=1
		get "$RX/hv_enable"; [ "$REPLY" = $a ] || put "$RX/hv_enable" $a
	fi

	# write
	if [ ! -e "$C/charge_behaviour" ]; then
		[ $stop = 1 ] && chg=100
	elif [ $stop = 1 ]; then
		sel "$C/charge_behaviour"; [ "$REPLY" = inhibit-charge ] || put "$C/charge_behaviour" inhibit-charge
	else
		sel "$C/charge_behaviour"; [ "$REPLY" = auto ] || put "$C/charge_behaviour" auto
	fi
	case $src in
	wired)	setlim "$C/input_current_limit" ceil $in $chg; win=$in ;;
	wireless) if [ $wl_busy = 1 ]; then setone "$C/constant_charge_current" $chg; why+=" pad changing voltage"
		else setlim "$W/input_current_limit" wceil $in $chg; fi; win=0 ;;
	none)	setlim "$C/input_current_limit" ceil 500 500; win=0 wceil=0 ;;
	esac
	if [ $src = none ]; then led_now 0; else led_now 1; fi
	if [ $src = wired ]; then
		last_fp=$sess_fp last_in=$in last_hv=$hvbus
		# the highest limit that held for HELD_S, for --show
		a=$in
		if [ $ramp = 1 ]; then num "$C/$RAMP_EFFECTIVE" && a=$((REPLY / 1000))
		else num "$C/input_current_limit" && a=$((REPLY / 1000)); fi
		if [ "$a" != "$held_val" ]; then held_val=$a held_since=$NOW
		elif [ $((NOW - held_since)) -ge $HELD_S ] && [ -n "$sess_fp" ] && mem_get "$sess_fp" &&
		     [ $a -gt $m_held ]; then
			m_held=$a; mem_put "$sess_fp"
		fi
	fi

	# one line per decision, not per uevent
	t="$src $type"; [ $hvbus = 1 ] && t+=" $((volt / 1000)) V"
	t+=": in $in mA, charge $chg mA"
	[ $stop = 1 ] && t+=", stopped"
	[ -n "$why" ] && t+=" (${why# })"
	[ -n "$rs" ] && t+=", ramp $rs"
	if [ "$t" != "$logged" ]; then
		logged=$t
		a=$T s=; [ $a -lt 0 ] && a=$((-a)) s=-
		if [ $tknown = 1 ]; then t+=", battery $s$((a / 10)).$((a % 10)) C"; else t+=", battery temperature unknown"; fi
		if [ $ramp = 1 ] && [ $src = wired ]; then
			num "$C/$RAMP_EFFECTIVE" && t+=", effective $((REPLY / 1000)) mA"
			num "$C/$RAMP_FOUND" && t+=", found $((REPLY / 1000)) mA"
		fi
		echo "zrn-charge: $t"
	fi

	if [ $settle -gt $NOW ]; then nap=1
	elif [ $src = none ]; then nap=300
	elif [ $hv = 1 ]; then nap=10	# the screen, for the 9 V limit
	else nap=30
	fi
	[ $src = wired ] && [ $held_since = $NOW ] && [ $nap -gt $HELD_S ] && nap=$HELD_S
}

daemon_pid() {	# the running daemon's pid, if there is one
	local pid args
	get "$RUN/pid" || return 1
	pid=$REPLY
	[ -r "/proc/$pid/cmdline" ] || return 1
	mapfile -d '' -t args < "/proc/$pid/cmdline" 2>/dev/null
	[[ "${args[*]}" == *zrn-charge*--daemon* ]] && REPLY=$pid
}

daemon() {
	local mon end
	echo $$ > "$RUN/pid"
	exec 3< <(exec $MONITOR)
	mon=$!
	trap 'rm -f "$RUN/pid"; kill $mon 2>/dev/null; exit 0' TERM INT
	trap : USR1	# a lone `zrn-charge` asks for a pass
	load
	while :; do
		pass; save
		read -r -t $nap -u 3 _
		case $? in
		0)	now; end=$((NOW + 2))	# the burst: wait for quiet, at most 2 s
			while read -r -t $DEBOUNCE -u 3 _; do now; [ $NOW -ge $end ] && break; done ;;
		1)	echo "zrn-charge: the uevent monitor stopped"; exit 1 ;;
		esac
	done
}

show() {
	local f h t v a s fp d any=0
	now; mem_age 2>/dev/null
	for f in "$MEM"/*; do
		[ -f "$f" ] || continue
		read -r h t v a s fp < "$f" 2>/dev/null || continue
		any=1 d=
		[ "$h" -gt 0 ] && d+=", held $h mA"
		[ "$t" -gt 0 ] && d+=", tripped at $t mA (now at most $(( t - 200 < 500 ? 500 : t - 200 )) mA)"
		[ "$v" = 1 ] && d+=", 5 V only (tripped at 9 V)"
		[ "$a" = 1 ] && d+=", PD anomaly (Hard Reset, other caps): 5 V only"
		printf '%s: last seen %(%Y-%m-%d)T%s\n' "$fp" "$s" "$d"
	done
	[ $any = 1 ] || echo "zrn-charge: no charger remembered"
}
forget() {	# fingerprint, or all
	local f
	case ${1:-} in
	'')	echo "usage: zrn-charge --forget FINGERPRINT|all" >&2; return 2 ;;
	all)	for f in "$MEM"/*; do [ -f "$f" ] && { rm -f "$f" || return 1; }; done ;;
	*)	mem_file "$1"
		[ -f "$REPLY" ] || { echo "zrn-charge: no charger \"$1\" remembered" >&2; return 1; }
		rm -f "$REPLY" ;;
	esac
}

case ${1:-} in
--show) show; exit 0 ;;
--forget) forget "${2:-}"; exit ;;
esac
mkdir -p "$RUN" 2>/dev/null
case ${1:-} in
--daemon) daemon ;;
*)
	if daemon_pid; then kill -USR1 "$REPLY" 2>/dev/null; exit 0; fi
	load
	pass
	# without the usbc driver the MUIC takes a few seconds to tell the type
	n=${ZRN_CHARGE_DETECT_S:-14}
	while [ $src = wired ] && [ $type = unknown ] && [ $n -gt 0 ]; do
		sleep 1; n=$((n - 1)); pass
	done
	save
	;;
esac
exit 0
