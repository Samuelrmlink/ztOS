#!/bin/sh
# XFCE on ztMETRO's desktop output (ztmetro/desktop/DESIGN.md).
#
# The shell starts this (the control pipe's "desktop start", or a monitor
# coming when Settings' "Start the desktop automatically" is on), with
# ZT_DESKTOP=1 (so every window of the session opens on the desktop),
# XDG_CURRENT_DESKTOP=XFCE, WAYLAND_DISPLAY and DISPLAY (Xwayland) set.
#
#   ztos-desktop-session            the panel, the desktop and the settings
#                                   daemon, each started again if it dies
#   ztos-desktop-session --refresh  the desktop moved to another output: the
#                                   panel and the desktop are put up again there
#
# There is no xfwm4 (X11 only): the shell is the window manager. There is no
# xfce4-session either; the pieces are started here, as labwc's XFCE does.
set -u
log=${XDG_STATE_HOME:-$HOME/.local/state}/ztos-desktop.log
mkdir -p "$(dirname "$log")"

if [ "${1:-}" = --refresh ]; then
	xfce4-panel -r >/dev/null 2>&1 || true
	pkill -u "$(id -u)" -x xfdesktop || true	# its loop starts it again
	exit 0
fi

[ -f "$log" ] && mv "$log" "$log.1"
exec >"$log" 2>&1
echo "desktop session on ${ZT_DESKTOP_OUTPUT:-?} (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} DISPLAY=${DISPLAY:-})"

export ZT_DESKTOP=1 XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_DESKTOP=xfce DESKTOP_SESSION=xfce
export GDK_BACKEND=wayland,x11 QT_QPA_PLATFORM=wayland\;xcb MOZ_ENABLE_WAYLAND=1
# the phone's own variables are not for desktop apps
unset ZTMETRO_SCALE ZTRF_SHELL_STYLE

# The panel's first start asks which layout to use, in a dialog: give it
# XFCE's default instead (the user's own, once there is one, is left alone).
conf=${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/xfconf/xfce-perchannel-xml
if [ ! -f "$conf/xfce4-panel.xml" ]; then
	for d in /usr/share/ztos-desktop /etc/xdg/xfce4/panel; do
		if [ -f "$d/xfce4-panel.xml" ]; then
			mkdir -p "$conf" && cp "$d/xfce4-panel.xml" "$conf/xfce4-panel.xml"; break
		elif [ -f "$d/default.xml" ]; then
			mkdir -p "$conf" && cp "$d/default.xml" "$conf/xfce4-panel.xml"; break
		fi
	done
fi

# A panel from before ztos-status: the phone's status and the volume are put
# in front of its clock, once (taken out again, they stay out).
mark=${XDG_CONFIG_HOME:-$HOME/.config}/ztmetro/desktop-panel-status
if [ ! -e "$mark" ] && [ -f "$conf/xfce4-panel.xml" ] && command -v xfconf-query >/dev/null &&
   ! grep -q '"ztos-status"' "$conf/xfce4-panel.xml"; then
	ids=$(xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids 2>/dev/null | grep -E '^[0-9]+$')
	top=$(xfconf-query -c xfce4-panel -l 2>/dev/null | sed -n 's|^/plugins/plugin-\([0-9]*\)$|\1|p' | sort -n | tail -1)
	if [ -n "$ids" ] && [ -n "$top" ]; then
		st=$((top + 1)) pa=$((top + 2))
		xfconf-query -c xfce4-panel -p /plugins/plugin-$st -n -t string -s ztos-status
		new=
		if [ -d /usr/lib/xfce4/panel/plugins ] && [ -e /usr/lib/xfce4/panel/plugins/libpulseaudio-plugin.so ]; then
			xfconf-query -c xfce4-panel -p /plugins/plugin-$pa -n -t string -s pulseaudio
			xfconf-query -c xfce4-panel -p /plugins/plugin-$pa/enable-keyboard-shortcuts -n -t bool -s false
			xfconf-query -c xfce4-panel -p /plugins/plugin-$pa/show-notifications -n -t uint -s 0
			new="-t int -s $st -t int -s $pa"
		else
			new="-t int -s $st"
		fi
		clock=$(xfconf-query -c xfce4-panel -l -v 2>/dev/null | sed -n 's|^/plugins/plugin-\([0-9]*\) *clock$|\1|p' | head -1)
		args= put=
		for i in $ids; do
			[ "$i" = "$clock" ] && [ -z "$put" ] && { args="$args $new"; put=1; }
			args="$args -t int -s $i"
		done
		[ -z "$put" ] && args="$args $new"
		# shellcheck disable=SC2086
		xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids --force-array $args &&
			echo "panel: ztos-status added" && mkdir -p "$(dirname "$mark")" && : > "$mark"
	fi
fi

# one program, started again when it dies, not more than 5 times a minute
keep() {
	name=$1; shift
	command -v "$1" >/dev/null 2>&1 || { echo "$name: not installed"; return; }
	(
		n=0; t0=$(date +%s)
		while :; do
			echo "$name: start"
			"$@"
			echo "$name: exited $?"
			now=$(date +%s)
			if [ $((now - t0)) -gt 60 ]; then n=0; t0=$now; fi
			n=$((n + 1))
			[ $n -ge 5 ] && { echo "$name: given up"; exit 0; }
			sleep 1
		done
	) &
}

keep xfsettingsd xfsettingsd --no-daemon --replace
# Thunar's daemon, ours: otherwise D-Bus starts it (for xfdesktop's icons)
# without ZT_DESKTOP, and the folders it opens land on the phone
keep thunar thunar --daemon
keep xfdesktop xfdesktop
keep xfce4-panel xfce4-panel
# anything the user wants with it (one command per line)
auto=${XDG_CONFIG_HOME:-$HOME/.config}/ztmetro/desktop-autostart
[ -f "$auto" ] && while IFS= read -r line; do
	case "$line" in ''|\#*) continue ;; esac
	sh -c "$line" &
done < "$auto"

# the shell stops the session with SIGTERM to its process group. xfconfd is
# not in it (D-Bus starts it, for xfsettingsd and the panel): it goes too,
# so nothing of XFCE is left; D-Bus starts it again when it is asked for.
trap 'pkill -TERM -x -U "$(id -u)" xfconfd; kill 0; exit 0' TERM INT
wait
