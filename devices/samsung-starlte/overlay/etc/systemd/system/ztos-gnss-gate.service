[Unit]
Description=ztOS GNSS gate: GPS on only while something reads location (NMEA on 127.0.0.1:10110)

[Service]
ExecStart=/usr/local/sbin/ztos-gnss-gate
# /var/lib/ztos-gnss/last: the last fix, root only
StateDirectory=ztos-gnss
StateDirectoryMode=0700
ExecStopPost=/usr/bin/systemctl --no-block stop ztos-gnss.service
# no gate, no switch: the shell's Location tile shows it as unavailable
ExecStopPost=-/bin/rm -f /run/ztos-gnss/state /run/ztos-gnss/control
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
