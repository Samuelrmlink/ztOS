[Unit]
Description=ztOS Waydroid network recovery
After=waydroid-container.service
# Waydroid set up (images, and a kernel with binder): ztos-waydroid-images
ConditionPathExists=/var/lib/waydroid/waydroid.cfg

[Service]
Type=simple
ExecStart=/usr/local/libexec/ztos-waydroid-network
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
