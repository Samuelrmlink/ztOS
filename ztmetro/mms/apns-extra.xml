<?xml version="1.0" encoding="utf-8"?>
<!--
  Access points the phone's stock apns-conf.xml (Samsung, G960FXXUHFVG4)
  lacks or may lack, read after it by apnconf.c. Same format as Android's.

  Mint Mobile: from LineageOS's apns-conf.xml (lineage-22.1, carrier "Mint",
  310/240, GID1 756D, apn Wholesale). Other sources (mobile-broadband-
  provider-info, March 2022) list Mint under 310/260 with no GID, and Mint's
  own help pages give "Wholesale" with the same MMSC. Which MCC/MNC and GID1
  a Mint SIM really reports is to be read off the SIM (Settings shows it);
  both are here, behind the GID, so a T-Mobile SIM is never taken for Mint.

  T-Mobile US: the same values as stock's and LineageOS's entry, so the
  auto-fill works where the stock file cannot be read.
-->
<apns version="8">
  <apn carrier="Mint"
      mcc="310" mnc="240"
      apn="Wholesale"
      type="default,supl,mms,ia"
      protocol="IPV4V6"
      roaming_protocol="IPV4V6"
      mmsc="http://wholesale.mmsmvno.com/mms/wapenc"
      mvno_type="gid" mvno_match_data="756D"
  />
  <apn carrier="Mint IMS"
      mcc="310" mnc="240"
      apn="ims" type="ims" protocol="IPV6"
      mvno_type="gid" mvno_match_data="756D"
  />
  <apn carrier="Mint"
      mcc="310" mnc="260"
      apn="Wholesale"
      type="default,supl,mms,ia"
      protocol="IPV4V6"
      roaming_protocol="IPV4V6"
      mmsc="http://wholesale.mmsmvno.com/mms/wapenc"
      mvno_type="gid" mvno_match_data="756D"
  />
  <apn carrier="Mint IMS"
      mcc="310" mnc="260"
      apn="ims" type="ims" protocol="IPV6"
      mvno_type="gid" mvno_match_data="756D"
  />
  <apn carrier="T-Mobile US LTE"
      mcc="310" mnc="260"
      apn="fast.t-mobile.com"
      mmsc="http://mms.msg.eng.t-mobile.com/mms/wapenc"
      type="default,supl,mms,xcap"
      protocol="IPV6"
      roaming_protocol="IP"
      mtu="1440"
  />
  <apn carrier="T-Mobile IMS"
      mcc="310" mnc="260"
      apn="ims" type="ims" protocol="IPV6" mtu="1440"
  />
</apns>
