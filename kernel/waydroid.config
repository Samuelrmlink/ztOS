# Kernel side of the optional ztos-waydroid package (packages/ztos-waydroid,
# docs/waydroid.md). Applied by `scripts/build-boot.sh NAME ... --waydroid`;
# each line is SYMBOL VALUE (y, n, a number, or "" for an empty string).
# Everything is built in: build-boot.sh builds no modules.
# Unused, these cost image size and a little memory, and nothing at runtime
# (no device node, no hook, no table exists until something creates one).

# Binder: binderfs only; Waydroid mounts /dev/binderfs and makes its own
# binder, hwbinder and vndbinder there. No static /dev/binder* devices.
ANDROID_BINDER_IPC y
ANDROID_BINDERFS y
ANDROID_BINDER_DEVICES ""

# Pressure stall information: Android's lmkd (ro.lmk.use_psi) and
# ztos-memory-policy. Boot-time switch psi=0 turns it off again.
PSI y

# The container's network: veth pair onto the waydroid0 bridge
VETH y
BRIDGE y

# waydroid-net.sh's nftables NAT (masquerade) and its input/forward accepts
NF_CONNTRACK y
NF_NAT y
NF_TABLES y
NF_TABLES_INET y
NF_TABLES_IPV4 y
NF_TABLES_IPV6 y
NFT_CT y
NFT_NAT y
NFT_MASQ y
NFT_REJECT y
NFT_COMPAT y
NFT_FIB_INET y
NFT_FIB_IPV4 y
NFT_FIB_IPV6 y

# Android's netd: policy routing (ip rule; without it RouteController fails
# and ztos-waydroid-network has to add a default route by hand), and the
# iptables (xtables, legacy) chains and matches it sets up at boot
IP_ADVANCED_ROUTER y
IP_MULTIPLE_TABLES y
IPV6_MULTIPLE_TABLES y
NETFILTER_XTABLES y
# Android 13's iptables is the legacy one (not iptables-nft)
NETFILTER_XTABLES_LEGACY y
IP_NF_IPTABLES_LEGACY y
IP6_NF_IPTABLES_LEGACY y
IP_NF_IPTABLES y
IP_NF_FILTER y
IP_NF_MANGLE y
IP_NF_RAW y
IP_NF_NAT y
IP_NF_TARGET_MASQUERADE y
IP_NF_TARGET_REJECT y
IP6_NF_IPTABLES y
IP6_NF_FILTER y
IP6_NF_MANGLE y
IP6_NF_RAW y
IP6_NF_TARGET_REJECT y
NETFILTER_XT_MARK y
NETFILTER_XT_CONNMARK y
NETFILTER_XT_TARGET_CHECKSUM y
NETFILTER_XT_TARGET_CT y
NETFILTER_XT_TARGET_IDLETIMER y
NETFILTER_XT_TARGET_NFLOG y
NETFILTER_XT_TARGET_TCPMSS y
NETFILTER_XT_MATCH_BPF y
NETFILTER_XT_MATCH_COMMENT y
NETFILTER_XT_MATCH_CONNTRACK y
NETFILTER_XT_MATCH_LENGTH y
NETFILTER_XT_MATCH_LIMIT y
NETFILTER_XT_MATCH_MAC y
NETFILTER_XT_MATCH_MULTIPORT y
NETFILTER_XT_MATCH_OWNER y
NETFILTER_XT_MATCH_PKTTYPE y
NETFILTER_XT_MATCH_QUOTA y
NETFILTER_XT_MATCH_SOCKET y
NETFILTER_XT_MATCH_STATE y
NETFILTER_XT_MATCH_STATISTIC y
NETFILTER_XT_MATCH_U32 y
NETFILTER_NETLINK_LOG y

# netd closes sockets of a network that went away (SOCK_DESTROY)
INET_DIAG y
INET_UDP_DIAG y
INET_DIAG_DESTROY y
